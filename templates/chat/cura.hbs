  <p>{{localize "DESORDEM.Habilidade.CuraValor"}}: <strong>{{total}} {{resourceLabel}}</strong></p>
  <button type="button" data-desordem-curar>{{localize "DESORDEM.Recuperacao.Botao" valor=total recurso=resourceLabel}}</button>
</div>

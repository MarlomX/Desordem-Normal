<div class="desordem-teste {{#if success}}desordem-teste--sucesso{{else}}desordem-teste--falha{{/if}}">
  <h4 class="desordem-teste__titulo">{{titulo}}</h4>
  <p><strong>{{ganho}}</strong></p>
  <p class="desordem-ficha__dica">{{pericia}}{{#if folego}} · {{folego}}{{/if}}{{#if esforco}} · {{esforco}}{{/if}}</p>
  {{#if aviso}}<p class="desordem-ficha__dica">{{aviso}}</p>{{/if}}
</div>

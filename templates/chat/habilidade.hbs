<div class="desordem-relacao-chat">
  <p class="desordem-relacao-chat__titulo"><strong>{{title}}</strong> {{text}}</p>
  {{#if detail}}<p class="desordem-ficha__dica">{{detail}}</p>{{/if}}
  {{#if effect}}<p class="desordem-ficha__dica desordem-habilidade-chat__efeito"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{effect}}</p>{{/if}}
</div>

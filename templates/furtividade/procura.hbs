<section class="desordem-procura__corpo">
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Furtividade.Procura.Dica"}}</p>

  <fieldset class="desordem-pre__grupo desordem-procura__tabela{{#if state.tableCollapsed}} is-recolhida{{/if}}">
    <legend>
      <button type="button" class="desordem-procura__recolher" data-action="toggleTable" aria-expanded="{{#if state.tableCollapsed}}false{{else}}true{{/if}}" title="{{#if state.tableCollapsed}}{{localize "DESORDEM.Furtividade.Tabela.Expandir"}}{{else}}{{localize "DESORDEM.Furtividade.Tabela.Recolher"}}{{/if}}"><i class="fa-solid {{#if state.tableCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i> <i class="fa-solid fa-table-list" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Tabela.Titulo"}}</button>
    </legend>
    {{! Linha de cima: Sortear à esquerda, Editar à direita (aparece também com a tabela recolhida) }}
    <div class="desordem-procura__tabela-topo">
      <button type="button" data-action="drawRow" title="{{localize "DESORDEM.Furtividade.Tabela.SortearDica"}}" {{#unless tabela}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Tabela.Sortear"}}{{#if tabela}} (d{{tabela.dado}}){{/if}}</button>
      <button type="button" data-action="editTables"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Tabela.Editar"}}</button>
    </div>
    {{#unless state.tableCollapsed}}
    {{#if tabelas.length}}
    <select name="tabela" aria-label="{{localize "DESORDEM.Furtividade.Tabela.Escolher"}}">
      {{#each tabelas}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{nome}}</option>{{/each}}
    </select>
    {{#if tabela.linhas.length}}
    <ul class="desordem-procura__linhas">
      {{#each tabela.linhas}}
      <li><button type="button" class="desordem-procura__linha{{#if selected}} is-escolhida{{/if}}" data-action="selectRow" data-row-id="{{id}}"><strong>{{faixa}}</strong> <span>{{texto}}</span></button></li>
      {{/each}}
    </ul>
    {{else}}
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Furtividade.Tabela.SemLinhas"}}</p>
    {{/if}}
    {{#if linha}}
    <p class="desordem-procura__nota"><strong>{{linha.faixa}}</strong> {{linha.texto}}{{#if linha.sorteado}}<br><em>{{linha.sorteado}}</em>{{/if}}</p>
    {{/if}}
    {{else}}
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Furtividade.Tabela.SemTabelas"}}</p>
    {{/if}}
    {{/unless}}
  </fieldset>
  <label class="desordem-procura__campo">
    <span>{{localize "DESORDEM.Furtividade.Procura.Campo"}}</span>
    <input type="text" name="busca" value="{{state.text}}" placeholder="2d6 · d10 · 3 5" autocomplete="off">
  </label>
  <label class="desordem-procura__campo">
    <span>{{localize "DESORDEM.Furtividade.Procura.Alvo"}}</span>
    <select name="modo">
      {{#each modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </label>
  {{#if escolhido}}
  <label class="desordem-procura__campo">
    <span>{{localize "DESORDEM.Furtividade.Procura.Escolhido"}}</span>
    <select name="alvo">
      {{#each candidates}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
    </select>
  </label>
  {{/if}}
  {{#unless hasCandidates}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Furtividade.Procura.Erro.semAlvo"}}</p>{{/unless}}
  <footer class="desordem-perseguicao__acoes">
    <button type="button" data-action="search" {{#unless hasCandidates}}disabled{{/unless}}><i class="fa-solid fa-eye" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Procura.Procurar"}}</button>
    <button type="button" data-action="drawTarget" {{#unless hasCandidates}}disabled{{/unless}}><i class="fa-solid fa-shuffle" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Procura.SortearAlvo"}}</button>
  </footer>
</section>

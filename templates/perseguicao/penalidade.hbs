<div class="desordem-perseguicao-penalidade">
  <label class="desordem-perseguicao-penalidade__campo">
    <span>{{localize "DESORDEM.Perseguicao.Penalidade.Valor"}}</span>
    <input type="text" name="valor" placeholder="2d6" autocomplete="off" autofocus>
  </label>
  {{! PV ou PD: dois botões que se excluem (rádios com a aparência de botão) }}
  <div class="desordem-perseguicao-penalidade__campo">
    <span>{{localize "DESORDEM.Perseguicao.Penalidade.Tipo"}}</span>
    <div class="desordem-tipo-botoes" role="radiogroup">
      <label class="desordem-tipo-botoes__opcao desordem-tipo-botoes__opcao--pv"><input type="radio" name="tipo" value="pv" checked><span>{{localize "DESORDEM.Perseguicao.Penalidade.PV"}}</span></label>
      <label class="desordem-tipo-botoes__opcao desordem-tipo-botoes__opcao--pd"><input type="radio" name="tipo" value="pd"><span>{{localize "DESORDEM.Perseguicao.Penalidade.PD"}}</span></label>
    </div>
  </div>
  {{! Desafio: o mestre marca quem leva a penalidade (só eles recebem o botão no cartão) }}
  {{#if escolhas.length}}
  <div class="desordem-perseguicao-penalidade__campo">
    <span>{{localize "DESORDEM.Desafio.Penalidade.Escolher"}}</span>
    <ul class="desordem-perseguicao-adicionar__lista">
      {{#each escolhas}}
      <li><label><input type="checkbox" name="alvo" value="{{id}}"> <span>{{name}}</span></label></li>
      {{/each}}
    </ul>
  </div>
  {{/if}}
  {{#if alvos}}<p class="desordem-ficha__dica"><strong>{{localize "DESORDEM.Furtividade.Consequencia.Alvos"}}</strong> {{alvos}}</p>{{/if}}
  <p class="desordem-ficha__dica">{{dica}}</p>
</div>

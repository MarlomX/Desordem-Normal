<section class="desordem-perseguicao">
  {{#if view}}
  <header class="desordem-perseguicao__topo">
    <span class="desordem-perseguicao__estado{{#if view.ativa}} is-ativa{{/if}}">{{#if view.ativa}}{{localize "DESORDEM.Perseguicao.EmAndamento"}}{{else}}{{localize "DESORDEM.Perseguicao.EmPreparacao"}}{{/if}}</span>
    {{#if view.ativa}}<span class="desordem-perseguicao__rodada">{{localize "DESORDEM.Perseguicao.Rodada" rodada=view.rodadaAtual}}</span>{{/if}}
  </header>

  <h3 class="desordem-perseguicao__titulo"><i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Participantes"}} ({{view.participantes.length}})</h3>
  {{#if view.participantes.length}}
  <ul class="desordem-perseguicao__lista">
    {{#each view.participantes}}
    <li class="desordem-perseguicao__item">
      <img class="desordem-perseguicao__retrato" src="{{img}}" alt="">
      <span class="desordem-perseguicao__nome">{{name}}</span>
      {{#if @root.isGM}}
      <button type="button" class="desordem-perseguicao__remover" data-action="removeParticipant" data-combatant-id="{{id}}" title="{{localize "DESORDEM.Perseguicao.Remover"}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="desordem-perseguicao__vazio">{{localize "DESORDEM.Perseguicao.SemParticipantes"}}</p>
  {{/if}}

  {{#if @root.isGM}}
  <footer class="desordem-perseguicao__acoes">
    <button type="button" data-action="addParticipants"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Adicionar"}}</button>
    {{#if view.ativa}}
    <button type="button" data-action="endChase"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Encerrar"}}</button>
    {{else}}
    <button type="button" data-action="startChase"><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Iniciar"}}</button>
    {{/if}}
    <button type="button" class="desordem-perseguicao__perigo" data-action="deleteChase"><i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Excluir"}}</button>
  </footer>
  {{/if}}
  {{else}}
  <p class="desordem-perseguicao__vazio">{{#if @root.isGM}}{{localize "DESORDEM.Perseguicao.SemPerseguicaoMestre"}}{{else}}{{localize "DESORDEM.Perseguicao.SemPerseguicao"}}{{/if}}</p>
  {{#if access.canCreate}}
  <footer class="desordem-perseguicao__acoes">
    <button type="button" data-action="createChase"><i class="fa-solid fa-person-running" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Criar"}}</button>
  </footer>
  {{/if}}
  {{/if}}
</section>

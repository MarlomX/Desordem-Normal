<section class="desordem-perseguicao">
  {{#if view}}
  <header class="desordem-perseguicao__topo">
    <span class="desordem-perseguicao__estado{{#if view.ativa}} is-ativa{{/if}}">{{#if view.ativa}}{{localize "DESORDEM.Perseguicao.EmAndamento"}}{{else}}{{localize "DESORDEM.Perseguicao.EmPreparacao"}}{{/if}}</span>
    {{#if view.ativa}}<span class="desordem-perseguicao__rodada">{{localize "DESORDEM.Perseguicao.Rodada" rodada=view.rodadaAtual}}</span>{{/if}}
    <span class="desordem-perseguicao__valor">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Perseguicao.DT"}}</span>
      {{#if @root.isGM}}<button type="button" class="desordem-perseguicao__passo" data-action="adjustDt" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>{{/if}}
      {{#if @root.isGM}}
      <input type="number" class="desordem-perseguicao__campo" data-campo="dt" value="{{view.dt}}" min="1" max="40" step="1" inputmode="numeric" aria-label="{{localize "DESORDEM.Perseguicao.DT"}}">
      {{else}}
      <strong>{{view.dt}}</strong>
      {{/if}}
      {{#if @root.isGM}}<button type="button" class="desordem-perseguicao__passo" data-action="adjustDt" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>{{/if}}
    </span>
  </header>

  <h3 class="desordem-perseguicao__titulo"><i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Participantes"}} ({{view.participantes.length}})</h3>
  {{#if view.participantes.length}}
  <ul class="desordem-perseguicao__lista">
    {{#each view.participantes}}
    <li class="desordem-perseguicao__item{{#if agiu}} is-agiu{{/if}}">
      <div class="desordem-perseguicao__linha">
        <img class="desordem-perseguicao__retrato" src="{{img}}" alt="">
        <span class="desordem-perseguicao__nome">{{name}}</span>
        {{#if @root.isGM}}
        <button type="button" class="desordem-perseguicao__remover" data-action="removeParticipant" data-combatant-id="{{id}}" title="{{localize "DESORDEM.Perseguicao.Remover"}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        {{/if}}
      </div>
      {{#if @root.view.ativa}}
      <div class="desordem-perseguicao__linha desordem-perseguicao__dados">
        <span class="desordem-perseguicao__valor">
          <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Perseguicao.PA"}}</span>
          {{#if podeEditar}}
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustParticipant" data-combatant-id="{{id}}" data-field="pa" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>
          <input type="number" class="desordem-perseguicao__campo" data-campo="pa" data-combatant-id="{{id}}" value="{{pa}}" min="0" step="1" inputmode="numeric" aria-label="{{localize "DESORDEM.Perseguicao.PA"}}">
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustParticipant" data-combatant-id="{{id}}" data-field="pa" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>
          {{else}}
          <strong>{{pa}}</strong>
          {{/if}}
        </span>
        <span class="desordem-perseguicao__valor">
          <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Perseguicao.Folego"}}</span>
          {{#if podeEditar}}
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustParticipant" data-combatant-id="{{id}}" data-field="folego" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>
          <input type="number" class="desordem-perseguicao__campo" data-campo="folego" data-combatant-id="{{id}}" value="{{folego}}" min="0" max="6" step="1" inputmode="numeric" aria-label="{{localize "DESORDEM.Perseguicao.Folego"}}">
          <strong>d6</strong>
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustParticipant" data-combatant-id="{{id}}" data-field="folego" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>
          {{else}}
          <strong>{{folego}}d6</strong>
          {{/if}}
        </span>
        <label class="desordem-perseguicao__agiu">
          <input type="checkbox" data-action="toggleActed" data-combatant-id="{{id}}" {{#if agiu}}checked{{/if}} {{#unless podeMarcar}}disabled{{/unless}}>
          <span>{{localize "DESORDEM.Perseguicao.Agiu"}}</span>
        </label>
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="desordem-perseguicao__vazio">{{localize "DESORDEM.Perseguicao.SemParticipantes"}}</p>
  {{/if}}

  {{#if @root.isGM}}
  <footer class="desordem-perseguicao__acoes">
    <button type="button" data-action="addParticipants"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Adicionar"}}</button>
    {{#if view.ativa}}
    <button type="button" data-action="nextRound"><i class="fa-solid fa-forward-step" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.ProximaRodada"}}</button>
    <button type="button" data-action="endChase"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Encerrar"}}</button>
    {{else}}
    <button type="button" data-action="startChase"><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Iniciar"}}</button>
    {{/if}}
    <button type="button" class="desordem-perseguicao__perigo" data-action="deleteChase"><i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Excluir"}}</button>
  </footer>
  {{/if}}
  {{else}}
  <p class="desordem-perseguicao__vazio">{{#if @root.isGM}}{{localize "DESORDEM.Perseguicao.SemPerseguicaoMestre"}}{{else}}{{localize "DESORDEM.Perseguicao.SemPerseguicao"}}{{/if}}</p>
  {{#if access.canCreate}}
  <footer class="desordem-perseguicao__acoes">
    <button type="button" data-action="createChase"><i class="fa-solid fa-person-running" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Criar"}}</button>
  </footer>
  {{/if}}
  {{/if}}
</section>

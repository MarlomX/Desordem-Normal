{{!--
  Editor de efeitos do catálogo (rolls/ability-effects-editor.js), usado pela ficha do item e pela
  janela do efeito da aba Condição (sheets/condition-effect-app.js). Recebe o contexto de quem o
  inclui: `effectsEditor` (linhas, tipos, textos) e `editable`. Os campos não têm `name` (não
  entram no formulário do Foundry): quem inclui o editor liga `[data-efeito-campo]` e as ações
  efeitoAdicionar, efeitoAbrir, efeitoSubir, efeitoDescer e efeitoRemover.
--}}
<section class="desordem-hab-efeitos">
  <h3 class="desordem-hab-efeitos__titulo">{{localize "DESORDEM.Efeito.Titulo"}}</h3>
  {{#if effectsEditor.legacy}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.Legado" nome=effectsEditor.legacyName}}</p>{{/if}}
  {{#if effectsEditor.empty}}<p class="desordem-ficha__dica">{{effectsEditor.emptyText}}</p>{{/if}}
  {{#if effectsEditor.hint}}<p class="desordem-ficha__dica">{{effectsEditor.hint}}</p>{{/if}}
  <datalist id="{{effectsEditor.datalistId}}">{{#each effectsEditor.resources}}<option value="{{this}}"></option>{{/each}}</datalist>
  {{#each effectsEditor.rows}}
  <div class="desordem-hab-efeito{{#if open}} is-aberto{{/if}}" data-efeito-id="{{id}}">
    <div class="desordem-hab-efeito__linha">
      <div class="desordem-hab-efeito__texto">
        <strong>{{tipoLabel}}</strong>
        <span class="desordem-hab-efeito__resumo">{{summary}}</span>
        {{#unless supported}}<span class="desordem-hab-efeito__aviso">{{localize "DESORDEM.Efeito.SemUso"}}</span>{{/unless}}
      </div>
      {{#if ../editable}}
      <div class="desordem-hab-efeito__botoes">
        <button type="button" data-action="efeitoAbrir" title="{{localize "DESORDEM.Efeito.Editar"}}"><i class="fa-solid {{#if open}}fa-chevron-up{{else}}fa-pen{{/if}}"></i></button>
        <button type="button" data-action="efeitoSubir" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Subir"}}" {{#if first}}disabled{{/if}}><i class="fa-solid fa-arrow-up"></i></button>
        <button type="button" data-action="efeitoDescer" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Descer"}}" {{#if last}}disabled{{/if}}><i class="fa-solid fa-arrow-down"></i></button>
        <button type="button" data-action="efeitoRemover" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Remover"}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/if}}
    </div>
    {{#if open}}
    <div class="desordem-hab-efeito__campos">
      {{#each fields}}
      {{#if isInt}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="number" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}" min="{{min}}" max="{{max}}"></label>{{/if}}
      {{#if isBool}}<label class="desordem-ficha__campo"><input type="checkbox" data-efeito="{{index}}" data-efeito-campo="{{key}}" {{#if value}}checked{{/if}}> <span>{{label}}</span></label>{{/if}}
      {{#if isText}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="text" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}"></label>{{/if}}
      {{#if isResource}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="text" list="{{../../effectsEditor.datalistId}}" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}"></label>{{/if}}
      {{#if isChoice}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      {{#if isDie}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      {{#if isSkill}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      {{#if isCost}}
      <fieldset class="desordem-hab-efeito__custo"><legend>{{label}}</legend>
        <select data-efeito="{{index}}" data-efeito-campo="{{key}}.tipo">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{#if paid}}<input type="number" min="0" max="20" data-efeito="{{index}}" data-efeito-campo="{{key}}.valor" value="{{value.valor}}">{{/if}}
        {{#if byResource}}<input type="text" list="{{../../effectsEditor.datalistId}}" placeholder="{{localize "DESORDEM.Efeito.Campos.recurso"}}" data-efeito="{{index}}" data-efeito-campo="{{key}}.recurso" value="{{value.recurso}}">{{/if}}
      </fieldset>
      {{/if}}
      {{#if isSkills}}
      <fieldset class="desordem-hab-efeito__pericias"><legend>{{label}}</legend>
        {{#each skills}}<label><input type="checkbox" data-efeito="{{../index}}" data-efeito-campo="pericias" data-pericia="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
        <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaPericias"}}</p>
      </fieldset>
      {{/if}}
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/each}}
  {{#if editable}}{{#unless effectsEditor.noTypes}}{{#if effectsEditor.canAdd}}
  <div class="desordem-hab-efeitos__novo">
    <select data-efeito-novo>{{#each effectsEditor.typeChoices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
    <button type="button" data-action="efeitoAdicionar"><i class="fa-solid fa-plus"></i> {{localize "DESORDEM.Efeito.Adicionar"}}</button>
  </div>
  {{else}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.Limite" n=effectsEditor.max}}</p>{{/if}}{{/unless}}{{/if}}
</section>

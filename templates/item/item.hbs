<div class="desordem-item">
  <header class="desordem-item__cabecalho">
    <img class="desordem-item__imagem" src="{{item.img}}" alt="{{item.name}}">
    <div class="desordem-item__identidade">
      <input class="desordem-ficha__nome" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
      <span class="desordem-ficha__dica">{{typeLabel}}</span>
    </div>
  </header>

  {{#if isWeapon}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Categoria.Titulo"}}</span>
      <select name="system.categoria" {{#unless editable}}disabled{{/unless}}>{{#each categoryChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.TipoArma"}}</span>
      <select name="system.tipo" {{#unless editable}}disabled{{/unless}}>{{#each kindChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{#unless isNatural}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Empunhadura.Titulo"}}</span>
      <select name="system.empunhadura" {{#unless editable}}disabled{{/unless}}>{{#each gripChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{/unless}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.BaseDano"}}</span>
      <select name="system.baseDano" {{#unless editable}}disabled{{/unless}}>{{#each baseChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.BonusDano"}}</span>
      <input type="number" name="system.bonusDano" value="{{system.bonusDano}}" min="-10" max="20" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pericia"}}</span>
      <select name="system.pericia" {{#unless editable}}disabled{{/unless}}>{{#each skillChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.naoLetal" {{#if system.naoLetal}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.NaoLetal"}}</span></label>
    {{#unless isNatural}}<label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Empunhada"}}</span></label>{{/unless}}
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.consumivel" {{#if system.consumivel}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Arremesso"}}</span></label>
    {{#if system.consumivel}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Quantidade"}}</span>
      <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    {{/if}}
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaNatural"}}</p>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaArremesso"}}</p>
  {{/if}}

  {{#if isArmor}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Subtipo.Titulo"}}</span>
      <select name="system.subtipo" {{#unless editable}}disabled{{/unless}}>{{#each armorKindChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Categoria.Titulo"}}</span>
      <select name="system.categoria" {{#unless editable}}disabled{{/unless}}>{{#each categoryChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{#if isShield}}
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Empunhada"}}</span></label>
    {{else}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pontos"}}</span>
      <input type="number" name="system.pontos" value="{{system.pontos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Restantes"}}</span>
      <input type="number" name="system.restantes" value="{{system.restantes}}" min="0" max="{{system.pontos}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.vestida" {{#if system.vestida}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Vestida"}}</span></label>
    {{/if}}
  </div>
  <p class="desordem-ficha__dica">{{#if isShield}}{{localize "DESORDEM.Item.DicaEscudo"}}{{else}}{{localize "DESORDEM.Item.DicaArmadura"}}{{/if}}</p>
  <fieldset class="desordem-hab-efeito__pericias desordem-item__penalidade"><legend>{{localize "DESORDEM.Item.Penalidade.Titulo"}}</legend>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Penalidade.Passos"}}</span>
      <input type="number" name="system.penalidadePassos" value="{{system.penalidadePassos}}" min="0" max="3" {{#unless editable}}disabled{{/unless}}>
    </label>
    {{#each penaltySkills}}<label><input type="checkbox" data-penalidade-pericia="{{key}}" {{#if checked}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}> {{label}}</label>{{/each}}
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.Penalidade.Dica"}}</p>
  </fieldset>
  {{/if}}

  {{#if isOther}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Quantidade"}}</span>
      <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.consumivel" {{#if system.consumivel}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Consumivel"}}</span></label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.UsosMax"}}</span>
      <input type="number" name="system.usosMax" value="{{system.usosMax}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Usos"}}</span>
      <input type="number" name="system.usos" value="{{system.usos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Empunhadura.Titulo"}}</span>
      <select name="system.empunhadura" {{#unless editable}}disabled{{/unless}}>{{#each gripChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.NaMao"}}</span></label>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaUso"}}</p>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaMao"}}</p>
  {{/if}}

  {{#if isAbility}}
  {{#unless ownerIsThreat}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.perfil" {{#if system.perfil}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Perfil"}}</span></label>
    {{#if editable}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Efeito.Modelo"}}</span>
      <select data-efeito-modelo><option value="">{{localize "DESORDEM.Efeito.ModeloEscolher"}}</option>{{#each effectsEditor.modelChoices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
    </label>
    {{/if}}
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaModelo"}}</p>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaCriatura"}}</p>
  {{/unless}}
  {{/if}}

  {{#if isCondition}}
  {{! Efeito da aba Condição: duração da cópia e chave do efeito pronto }}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Efeito.Duracao.Titulo"}}</span>
      <select name="system.duracao" {{#unless editable}}disabled{{/unless}}>{{#each durationChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Efeito.ChaveItem"}}</span>
      <input type="text" name="system.chave" value="{{system.chave}}" {{#unless editable}}disabled{{/unless}}>
    </label>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaItemCondicao"}}</p>
  {{/if}}

  {{#if effectsEditor}}
  {{> "desordem-normal.efeitos-editor"}}
  {{/if}}

  <label class="desordem-ficha__campo desordem-item__descricao"><span>{{localize "DESORDEM.Item.Descricao"}}</span>
    <textarea name="system.descricao" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.descricao}}</textarea>
  </label>
</div>

<div class="desordem-item">
  <header class="desordem-item__cabecalho">
    <img class="desordem-item__imagem" src="{{item.img}}" alt="{{item.name}}">
    <div class="desordem-item__identidade">
      <input class="desordem-ficha__nome" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
      <span class="desordem-ficha__dica">{{typeLabel}}</span>
    </div>
  </header>

  {{#if isWeapon}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.TipoArma"}}</span>
      <select name="system.tipo" {{#unless editable}}disabled{{/unless}}>{{#each kindChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{#unless system.natural}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Maos.Titulo"}}</span>
      <select name="system.maos" {{#unless editable}}disabled{{/unless}}>{{#each handsChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{/unless}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.BaseDano"}}</span>
      <select name="system.baseDano" {{#unless editable}}disabled{{/unless}}>{{#each baseChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.BonusDano"}}</span>
      <input type="number" name="system.bonusDano" value="{{system.bonusDano}}" min="-10" max="20" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pericia"}}</span>
      <select name="system.pericia" {{#unless editable}}disabled{{/unless}}>{{#each skillChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.naoLetal" {{#if system.naoLetal}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.NaoLetal"}}</span></label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.natural" {{#if system.natural}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Natural"}}</span></label>
    {{#unless system.natural}}<label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Empunhada"}}</span></label>{{/unless}}
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaNatural"}}</p>
  {{/if}}

  {{#if isArmor}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pontos"}}</span>
      <input type="number" name="system.pontos" value="{{system.pontos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Restantes"}}</span>
      <input type="number" name="system.restantes" value="{{system.restantes}}" min="0" max="{{system.pontos}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.vestida" {{#if system.vestida}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Vestida"}}</span></label>
  </div>
  {{/if}}

  {{#if isOther}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Quantidade"}}</span>
      <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.consumivel" {{#if system.consumivel}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Consumivel"}}</span></label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.UsosMax"}}</span>
      <input type="number" name="system.usosMax" value="{{system.usosMax}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Usos"}}</span>
      <input type="number" name="system.usos" value="{{system.usos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Maos.Titulo"}}</span>
      <select name="system.maos" {{#unless editable}}disabled{{/unless}}>{{#each handsChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.NaMao"}}</span></label>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaUso"}}</p>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaMao"}}</p>
  {{/if}}

  {{#if isAbility}}
  {{#unless ownerIsThreat}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.perfil" {{#if system.perfil}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Perfil"}}</span></label>
    {{#if editable}}
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Efeito.Modelo"}}</span>
      <select data-efeito-modelo><option value="">{{localize "DESORDEM.Efeito.ModeloEscolher"}}</option>{{#each effectsEditor.modelChoices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
    </label>
    {{/if}}
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaModelo"}}</p>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaCriatura"}}</p>
  {{/unless}}

  <section class="desordem-hab-efeitos">
    <h3 class="desordem-hab-efeitos__titulo">{{localize "DESORDEM.Efeito.Titulo"}}</h3>
    {{#if effectsEditor.legacy}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.Legado" nome=effectsEditor.legacyName}}</p>{{/if}}
    {{#if effectsEditor.empty}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.Vazio"}}</p>{{/if}}
    <datalist id="{{effectsEditor.datalistId}}">{{#each effectsEditor.resources}}<option value="{{this}}"></option>{{/each}}</datalist>
    {{#each effectsEditor.rows}}
    <div class="desordem-hab-efeito{{#if open}} is-aberto{{/if}}" data-efeito-id="{{id}}">
      <div class="desordem-hab-efeito__linha">
        <div class="desordem-hab-efeito__texto">
          <strong>{{tipoLabel}}</strong>
          <span class="desordem-hab-efeito__resumo">{{summary}}</span>
          {{#unless supported}}<span class="desordem-hab-efeito__aviso">{{localize "DESORDEM.Efeito.SemUso"}}</span>{{/unless}}
        </div>
        {{#if ../editable}}
        <div class="desordem-hab-efeito__botoes">
          <button type="button" data-action="efeitoAbrir" title="{{localize "DESORDEM.Efeito.Editar"}}"><i class="fa-solid {{#if open}}fa-chevron-up{{else}}fa-pen{{/if}}"></i></button>
          <button type="button" data-action="efeitoSubir" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Subir"}}" {{#if first}}disabled{{/if}}><i class="fa-solid fa-arrow-up"></i></button>
          <button type="button" data-action="efeitoDescer" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Descer"}}" {{#if last}}disabled{{/if}}><i class="fa-solid fa-arrow-down"></i></button>
          <button type="button" data-action="efeitoRemover" data-efeito="{{index}}" title="{{localize "DESORDEM.Efeito.Remover"}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{/if}}
      </div>
      {{#if open}}
      <div class="desordem-hab-efeito__campos">
        {{#each fields}}
        {{#if isInt}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="number" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}" min="{{min}}" max="{{max}}"></label>{{/if}}
        {{#if isBool}}<label class="desordem-ficha__campo"><input type="checkbox" data-efeito="{{index}}" data-efeito-campo="{{key}}" {{#if value}}checked{{/if}}> <span>{{label}}</span></label>{{/if}}
        {{#if isText}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="text" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}"></label>{{/if}}
        {{#if isResource}}<label class="desordem-ficha__campo"><span>{{label}}</span><input type="text" list="{{../../effectsEditor.datalistId}}" data-efeito="{{index}}" data-efeito-campo="{{key}}" value="{{value}}"></label>{{/if}}
        {{#if isChoice}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
        {{#if isDie}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
        {{#if isSkill}}<label class="desordem-ficha__campo"><span>{{label}}</span><select data-efeito="{{index}}" data-efeito-campo="{{key}}">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
        {{#if isCost}}
        <fieldset class="desordem-hab-efeito__custo"><legend>{{label}}</legend>
          <select data-efeito="{{index}}" data-efeito-campo="{{key}}.tipo">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{#if paid}}<input type="number" min="0" max="20" data-efeito="{{index}}" data-efeito-campo="{{key}}.valor" value="{{value.valor}}">{{/if}}
          {{#if byResource}}<input type="text" list="{{../../effectsEditor.datalistId}}" placeholder="{{localize "DESORDEM.Efeito.Campos.recurso"}}" data-efeito="{{index}}" data-efeito-campo="{{key}}.recurso" value="{{value.recurso}}">{{/if}}
        </fieldset>
        {{/if}}
        {{#if isSkills}}
        <fieldset class="desordem-hab-efeito__pericias"><legend>{{label}}</legend>
          {{#each skills}}<label><input type="checkbox" data-efeito="{{../index}}" data-efeito-campo="pericias" data-pericia="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
          <p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.DicaPericias"}}</p>
        </fieldset>
        {{/if}}
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}
    {{#if editable}}{{#if effectsEditor.canAdd}}
    <div class="desordem-hab-efeitos__novo">
      <select data-efeito-novo>{{#each effectsEditor.typeChoices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
      <button type="button" data-action="efeitoAdicionar"><i class="fa-solid fa-plus"></i> {{localize "DESORDEM.Efeito.Adicionar"}}</button>
    </div>
    {{else}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Efeito.Limite" n=effectsEditor.max}}</p>{{/if}}{{/if}}
  </section>
  {{/if}}

  <label class="desordem-ficha__campo desordem-item__descricao"><span>{{localize "DESORDEM.Item.Descricao"}}</span>
    <textarea name="system.descricao" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.descricao}}</textarea>
  </label>
</div>

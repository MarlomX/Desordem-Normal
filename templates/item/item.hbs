<div class="desordem-item">
  <header class="desordem-item__cabecalho">
    <img class="desordem-item__imagem" src="{{item.img}}" alt="{{item.name}}">
    <div class="desordem-item__identidade">
      <input class="desordem-ficha__nome" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
      <span class="desordem-ficha__dica">{{typeLabel}}</span>
    </div>
  </header>

  {{#if isWeapon}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.TipoArma"}}</span>
      <select name="system.tipo" {{#unless editable}}disabled{{/unless}}>{{#each kindChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Maos.Titulo"}}</span>
      <select name="system.maos" {{#unless editable}}disabled{{/unless}}>{{#each handsChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.BonusDano"}}</span>
      <input type="number" name="system.bonusDano" value="{{system.bonusDano}}" min="-10" max="20" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pericia"}}</span>
      <select name="system.pericia" {{#unless editable}}disabled{{/unless}}>{{#each skillChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.naoLetal" {{#if system.naoLetal}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.NaoLetal"}}</span></label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.empunhada" {{#if system.empunhada}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Empunhada"}}</span></label>
  </div>
  {{/if}}

  {{#if isArmor}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Pontos"}}</span>
      <input type="number" name="system.pontos" value="{{system.pontos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Gastos"}}</span>
      <input type="number" name="system.gastos" value="{{system.gastos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.vestida" {{#if system.vestida}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Vestida"}}</span></label>
  </div>
  {{/if}}

  {{#if isOther}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Quantidade"}}</span>
      <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><input type="checkbox" name="system.consumivel" {{#if system.consumivel}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>{{localize "DESORDEM.Item.Consumivel"}}</span></label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.UsosMax"}}</span>
      <input type="number" name="system.usosMax" value="{{system.usosMax}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Item.Usos"}}</span>
      <input type="number" name="system.usos" value="{{system.usos}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Item.DicaUso"}}</p>
  {{/if}}

  <label class="desordem-ficha__campo desordem-item__descricao"><span>{{localize "DESORDEM.Item.Descricao"}}</span>
    <textarea name="system.descricao" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.descricao}}</textarea>
  </label>
</div>

{{! Ponto de interesse, modo de leitura (v0.24.0; revelar e «novo» na v0.24.3), dentro do diário.
  Os botões de revelar usam data-ponto-acao (ligados à mão em _onRender da folha).
  gm = dono da página (mestre ou Assistente): quadro completo, com DT, notas, condições, contexto.
  Jogador: o contexto só traz o que ele pode ver (nome das perícias e linhas reveladas a ele). }}
<div class="desordem-normal desordem-ponto desordem-ponto--leitura">
  {{#if showTitle}}
  <header class="journal-page-header desordem-ponto__cabecalho">
    <h2 class="desordem-ponto__nome"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> {{nome}}</h2>
    {{#if numero}}<span class="desordem-ponto__numero">{{numero}}</span>{{/if}}
  </header>
  {{/if}}

  {{#if descricaoBasica}}
  <div class="desordem-ponto__descricao">{{{descricaoBasica}}}</div>
  {{/if}}

  {{#if imagem}}
  <figure class="desordem-ponto__imagem{{#if imagemEscondida}} is-escondida{{/if}}">
    <img src="{{imagem}}" alt="{{nome}}">
    {{#if imagemEscondida}}<figcaption><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "DESORDEM.Ponto.SoMestre"}}</figcaption>{{/if}}
  </figure>
  {{/if}}

  {{#if gm}}
  {{#if anyRevealed}}
  <div class="desordem-ponto__ferramentas">
    <button type="button" data-ponto-acao="esconderTudo">
      <i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "DESORDEM.Ponto.EsconderTudo"}}
    </button>
  </div>
  {{/if}}
  <div class="desordem-ponto__quadro" role="table" aria-label="{{localize "DESORDEM.Ponto.Quadro"}}">
    <div class="desordem-ponto__quadro-titulos" role="row">
      <span role="columnheader">{{localize "DESORDEM.Ponto.Pericia"}}</span>
      <span role="columnheader">{{localize "DESORDEM.Ponto.DT"}}</span>
      <span role="columnheader">{{localize "DESORDEM.Ponto.Informacao"}}</span>
    </div>
    {{#each board}}
    <div class="desordem-ponto__grupo desordem-ponto__cor-{{cor}}" role="rowgroup" data-bloco="{{id}}">
      <div class="desordem-ponto__grupo-nome" role="rowheader">
        {{#if oculta}}<i class="fa-solid fa-lock" data-tooltip="{{localize "DESORDEM.Ponto.OcultaDica"}}" aria-label="{{localize "DESORDEM.Ponto.Oculta"}}"></i>{{/if}}
        {{label}}
        {{#if linhas.length}}
        <button type="button" class="desordem-ponto__olho desordem-ponto__investigar" data-ponto-acao="investigar" data-tooltip="{{localize "DESORDEM.Ponto.Investigar.Abrir"}}" aria-label="{{localize "DESORDEM.Ponto.Investigar.Abrir"}}"><i class="fa-solid fa-magnifying-glass"></i></button>
        {{#if todasReveladas}}
        <button type="button" class="desordem-ponto__olho is-ativo" data-ponto-acao="blocoRevelar" data-revelar="0" data-tooltip="{{localize "DESORDEM.Ponto.EsconderBloco"}}" aria-label="{{localize "DESORDEM.Ponto.EsconderBloco"}}"><i class="fa-solid fa-eye"></i></button>
        {{else}}
        <button type="button" class="desordem-ponto__olho" data-ponto-acao="blocoRevelar" data-revelar="1" data-tooltip="{{localize "DESORDEM.Ponto.RevelarBloco"}}" aria-label="{{localize "DESORDEM.Ponto.RevelarBloco"}}"><i class="fa-solid fa-eye-slash"></i></button>
        {{/if}}
        {{/if}}
      </div>
      <div class="desordem-ponto__grupo-linhas">
        {{#each linhas}}
        <div class="desordem-ponto__linha" role="row" data-linha="{{id}}">
          <span class="desordem-ponto__linha-dt" role="cell">{{dt}}</span>
          <div class="desordem-ponto__linha-texto" role="cell">
            {{#if condicao}}<p class="desordem-ponto__linha-condicao">{{condicao}}</p>{{/if}}
            {{#if texto}}{{{texto}}}{{else}}<p class="desordem-ponto__sem-texto">{{localize "DESORDEM.Ponto.SemTexto"}}</p>{{/if}}
            {{#if notaMestre}}<p class="desordem-ponto__linha-nota"><i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{notaMestre}}</p>{{/if}}
          </div>
          <span class="desordem-ponto__linha-estado" role="cell">
            {{#if revelada}}
            <button type="button" class="desordem-ponto__olho is-ativo" data-ponto-acao="linhaRevelar" data-revelar="0" data-tooltip="{{localize "DESORDEM.Ponto.Revelada"}} — {{localize "DESORDEM.Ponto.Esconder"}}" aria-label="{{localize "DESORDEM.Ponto.Esconder"}}"><i class="fa-solid fa-eye"></i></button>
            {{else}}
            <button type="button" class="desordem-ponto__olho" data-ponto-acao="linhaRevelar" data-revelar="1" data-tooltip="{{localize "DESORDEM.Ponto.NaoRevelada"}} — {{localize "DESORDEM.Ponto.Revelar"}}" aria-label="{{localize "DESORDEM.Ponto.Revelar"}}"><i class="fa-solid fa-eye-slash"></i></button>
            {{/if}}
            {{#if reveladaPara}}
            <button type="button" class="desordem-ponto__jogadores is-ativo" data-ponto-acao="linhaJogadores" data-tooltip="{{localize "DESORDEM.Ponto.ReveladaParaNomes" nomes=reveladaParaNomes}}" aria-label="{{localize "DESORDEM.Ponto.ReveladaPara" n=reveladaPara}}"><i class="fa-solid fa-user-check"></i> {{reveladaPara}}</button>
            {{else}}
            <button type="button" class="desordem-ponto__jogadores" data-ponto-acao="linhaJogadores" data-tooltip="{{localize "DESORDEM.Ponto.RevelarJogadores"}}" aria-label="{{localize "DESORDEM.Ponto.RevelarJogadores"}}"><i class="fa-solid fa-user-plus"></i></button>
            {{/if}}
          </span>
        </div>
        {{/each}}
      </div>
    </div>
    {{else}}
    <p class="desordem-ponto__vazio">{{localize "DESORDEM.Ponto.Vazio"}}</p>
    {{/each}}
  </div>

  {{#if contexto}}
  <section class="desordem-ponto__mestre">
    <h3><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "DESORDEM.Ponto.Contexto"}}</h3>
    {{{contexto}}}
  </section>
  {{/if}}
  {{#if (or desafioAcesso desafio)}}
  <section class="desordem-ponto__mestre">
    <h3><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "DESORDEM.Ponto.DesafioAcesso"}}</h3>
    {{#if desafio}}
    {{#if desafio.missing}}
    <p class="desordem-ponto__vazio">{{localize "DESORDEM.Ponto.Desafio.Apagado"}}</p>
    {{else}}
    <button type="button" class="desordem-ponto__desafio-abrir" data-ponto-acao="desafioAbrir">
      <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "DESORDEM.Ponto.Desafio.Abrir" nome=desafio.nome}}
    </button>
    {{/if}}
    {{/if}}
    {{{desafioAcesso}}}
  </section>
  {{/if}}

  {{else}}
  <div class="desordem-ponto__quadro desordem-ponto__quadro--jogador">
    {{#each board}}
    <div class="desordem-ponto__grupo desordem-ponto__cor-{{cor}}">
      <div class="desordem-ponto__grupo-nome">{{label}}</div>
      {{#if linhas.length}}
      <div class="desordem-ponto__grupo-linhas">
        {{#each linhas}}
        <div class="desordem-ponto__linha{{#if novo}} is-novo{{/if}}" data-linha="{{id}}">
          <div class="desordem-ponto__linha-texto">
            {{#if novo}}<span class="desordem-ponto__novo">{{localize "DESORDEM.Ponto.Novo"}}</span>{{/if}}
            {{{texto}}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>

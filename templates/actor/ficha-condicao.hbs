<section class="desordem-aba{{#if tabState.condicao}} is-active{{/if}}" data-tab-panel="condicao">
{{! Ordem da aba (v0.22.1): Medo, Efeitos, Saúde, Trauma, barras temporárias (furtividade) e Reiniciar cena }}
<section class="desordem-ficha__secao desordem-ficha__medo">
  <h3><i class="fa-solid fa-ghost" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Medo"}}</h3>

  <div class="desordem-ficha__estado">
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.DadoPavor"}}</span>
      <span class="desordem-dado-campo">
        {{#if system.estado.pavor}}{{dadoPavor system.estado.pavor}}{{else}}<span class="desordem-dado-campo__vazio">—</span>{{/if}}
        <select class="desordem-forma__select" name="system.estado.pavor" {{#unless editable}}disabled{{/unless}}>
          {{#each fearChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </label>
  </div>

</section>
<section class="desordem-ficha__secao desordem-ficha__efeitos">
  <h3><i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Efeitos"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaEfeitos"}}</p>


  {{#each effects}}{{> "desordem-normal.efeito-linha"}}{{/each}}
  {{#unless effects.length}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.SemEfeitos"}}</p>{{/unless}}
  {{#if editable}}{{> "desordem-normal.efeitos-botoes"}}{{/if}}
</section>
<section class="desordem-ficha__secao desordem-ficha__saude">
  <h3><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Saude"}}</h3>

  <div class="desordem-ficha__estado">
    <label><input type="checkbox" name="system.estado.inconsciente" {{#if system.estado.inconsciente}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.inconsciente"}}</label>
    <label><input type="checkbox" name="system.estado.moribundo" {{#if system.estado.moribundo}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.moribundo"}}</label>
    <label><input type="checkbox" name="system.estado.morteLenta" {{#if system.estado.morteLenta}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morteLenta"}}</label>
    <label><input type="checkbox" name="system.estado.morto" {{#if system.estado.morto}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morto"}}</label>
  </div>

  <label class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Ficha.TestesLesaoCena"}}</span>
    <input type="number" name="system.cena.testesLesao" value="{{system.cena.testesLesao}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

  <label class="desordem-ficha__campo" title="{{localize "DESORDEM.Ficha.PrimeirosSocorrosDica"}}">
    <span>{{localize "DESORDEM.Ficha.PrimeirosSocorrosCena"}}</span>
    <input type="number" name="system.cena.primeirosSocorros" value="{{system.cena.primeirosSocorros}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

</section>
<section class="desordem-ficha__secao desordem-ficha__trauma">
  <h3><i class="fa-solid fa-brain" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Trauma"}}</h3>

  <div class="desordem-ficha__estado">
    <label><input type="checkbox" name="system.estado.estupor" {{#if system.estado.estupor}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.estupor"}}</label>
    <label><input type="checkbox" name="system.estado.colapso" {{#if system.estado.colapso}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.colapso"}}</label>
  </div>

  <label class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Ficha.TestesTraumaCena"}}</span>
    <input type="number" name="system.cena.testesTrauma" value="{{system.cena.testesTrauma}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

</section>
{{#if furtividade.ativa}}
{{! Só durante uma cena de furtividade em que o personagem participa }}
<section class="desordem-ficha__secao desordem-ficha__furtividade">
  <h3><i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Titulo"}}</h3>
  <div class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Furtividade.Condicao.Esconder"}}</span>
    <span class="desordem-perseguicao__valor">
      {{#if furtividade.podeAjustar}}<button type="button" class="desordem-perseguicao__passo" data-action="adjustHideUses" data-combatant-id="{{furtividade.combatantId}}" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>{{/if}}
      <strong>{{furtividade.esconderUsos}}</strong>
      {{#if furtividade.podeAjustar}}<button type="button" class="desordem-perseguicao__passo" data-action="adjustHideUses" data-combatant-id="{{furtividade.combatantId}}" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>{{/if}}
    </span>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Furtividade.Condicao.Dica" dt=furtividade.esconderDt}}</p>
</section>
{{/if}}
<section class="desordem-ficha__secao desordem-ficha__cena">
  <h3><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Cena"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaCena"}}</p>
  {{#if editable}}<button type="button" data-action="newScene">{{localize "DESORDEM.Habilidade.NovaCena"}}</button>{{/if}}
</section>
</section>

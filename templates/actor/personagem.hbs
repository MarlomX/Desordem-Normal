<div class="desordem-ficha">
<header class="desordem-ficha__cabecalho">
  <img class="desordem-ficha__retrato" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">

  <div class="desordem-ficha__identidade">
    <input class="desordem-ficha__nome" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.Nivel"}}</span>
      <input type="number" name="system.nivel" value="{{system.nivel}}" min="1" max="10" {{#unless editable}}disabled{{/unless}}>
    </label>
  </div>

  <div class="desordem-ficha__recursos">
    <div class="desordem-ficha__recurso">
      <span>{{localize "DESORDEM.Ficha.PV"}}</span>
      <input type="number" name="system.pv.value" value="{{system.pv.value}}" min="0" {{#unless editable}}disabled{{/unless}}>
      <span>/</span>
      <input type="number" name="system.pv.max" value="{{system.pv.max}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="desordem-ficha__recurso">
      <span>{{localize "DESORDEM.Ficha.PD"}}</span>
      <input type="number" name="system.pd.value" value="{{system.pd.value}}" min="0" {{#unless editable}}disabled{{/unless}}>
      <span>/</span>
      <input type="number" name="system.pd.max" value="{{system.pd.max}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>
</header>

<section class="desordem-ficha__secao desordem-ficha__saude">
  <h3>{{localize "DESORDEM.Ficha.Saude"}}</h3>

  <div class="desordem-ficha__estado">
    <label><input type="checkbox" name="system.estado.inconsciente" {{#if system.estado.inconsciente}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.inconsciente"}}</label>
    <label><input type="checkbox" name="system.estado.moribundo" {{#if system.estado.moribundo}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.moribundo"}}</label>
    <label><input type="checkbox" name="system.estado.morteLenta" {{#if system.estado.morteLenta}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morteLenta"}}</label>
    <label><input type="checkbox" name="system.estado.contusao" {{#if system.estado.contusao}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.contusao"}}</label>
    <label><input type="checkbox" name="system.estado.morto" {{#if system.estado.morto}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morto"}}</label>
  </div>

  <div class="desordem-ficha__acoes-saude">
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.Dano"}}</span>
      <input type="number" data-dano min="0" value="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo">
      <input type="checkbox" data-nao-letal {{#unless editable}}disabled{{/unless}}>
      <span>{{localize "DESORDEM.Ficha.NaoLetal"}}</span>
    </label>
    <button type="button" data-action="applyDamage" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.AplicarDano"}}</button>
    <button type="button" data-action="rollInjury" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.TesteLesao"}} ({{localize "DESORDEM.Teste.DT"}} {{nextInjuryDT}})</button>
  </div>

  <label class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Ficha.TestesLesaoCena"}}</span>
    <input type="number" name="system.cena.testesLesao" value="{{system.cena.testesLesao}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

</section>

<section class="desordem-ficha__secao desordem-ficha__medo">
  <h3>{{localize "DESORDEM.Ficha.Medo"}}</h3>

  <div class="desordem-ficha__estado">
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.DadoPavor"}}</span>
      <select name="system.estado.pavor" {{#unless editable}}disabled{{/unless}}>
        {{#each fearChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label><input type="checkbox" name="system.estado.estupor" {{#if system.estado.estupor}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.estupor"}}</label>
    <label><input type="checkbox" name="system.estado.colapso" {{#if system.estado.colapso}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.colapso"}}</label>
  </div>

  <div class="desordem-ficha__estado">
    <label><input type="checkbox" data-controlar-pavor {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.ControlarPavor"}}</label>
    <label><input type="checkbox" data-abracar-pavor {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.AbracarPavor"}}</label>
    <span class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaPavor"}}</span>
  </div>

  <div class="desordem-ficha__acoes-saude">
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.DanoEmocional"}}</span>
      <input type="number" data-dano-emocional min="0" value="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <button type="button" data-action="applyEmotionalDamage" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.AplicarDano"}}</button>
    <button type="button" data-action="rollTrauma" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.TesteTrauma"}} ({{localize "DESORDEM.Teste.DT"}} {{nextTraumaDT}})</button>
  </div>

  <label class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Ficha.TestesTraumaCena"}}</span>
    <input type="number" name="system.cena.testesTrauma" value="{{system.cena.testesTrauma}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Atributos"}}</h3>
  <div class="desordem-ficha__atributos">
    {{#each attributes}}
    <label class="desordem-ficha__campo">
      <span>{{label}}</span>
      <select name="system.atributos.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Pericias"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaRolagem"}}</p>
  <div class="desordem-ficha__pericias">
    {{#each skills}}
    <div class="desordem-ficha__pericia">
      <button type="button" class="desordem-ficha__rolar" data-action="rollSkill" data-skill="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{attrLabel}}</span>
      </button>
      <select name="system.pericias.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Aptidoes"}}</h3>
  <div class="desordem-ficha__pericias">
    {{#each aptitudes}}
    <div class="desordem-ficha__pericia">
      <button type="button" class="desordem-ficha__rolar" data-action="rollAptitude" data-aptitude="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <select name="system.aptidoes.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao desordem-ficha__habilidades">
  <h3>{{localize "DESORDEM.Ficha.Habilidades"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaHabilidades"}}</p>
  {{#each abilities}}
  <div class="desordem-habilidade" data-item-id="{{id}}" draggable="true">
    <div class="desordem-habilidade__titulo">
      <strong>{{name}}</strong>{{#if perfil}} <span class="desordem-efeito-ativo__origem">{{localize "DESORDEM.Item.PerfilEtiqueta"}}</span>{{/if}}
      <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
      {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
    </div>
    {{#if descricao}}<p class="desordem-ficha__dica">{{descricao}}</p>{{/if}}
    <div class="desordem-habilidade__controles">
      {{#if showImpeto}}
      <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Habilidade.Impeto"}}</span> <input type="number" name="system.recursos.impeto" value="{{impeto}}" min="0" max="5" {{#if locked}}disabled{{/if}}> / 5</label>
      <label class="desordem-ficha__campo"><input type="checkbox" data-ativa="impetoDado" {{#if impetoDadoAtivo}}checked{{/if}} {{#if locked}}disabled{{/if}}> <span>{{localize "DESORDEM.Habilidade.ImpetoDado"}}</span></label>
      <button type="button" data-action="impetoStep" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Habilidade.ImpetoPasso"}}</button>
      <button type="button" data-action="impetoAction" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Habilidade.ImpetoAcao"}}</button>
      {{/if}}
      {{#if showAnalise}}
      <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Habilidade.Marcadores"}}</span> <input type="number" name="system.recursos.analise" value="{{analise}}" min="0" max="4" {{#if locked}}disabled{{/if}}> / 4</label>
      <button type="button" data-action="gainAnalysis" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Habilidade.Analisar"}}</button>
      {{/if}}
      {{#if showDodge}}<button type="button" data-action="dodge" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Habilidade.Esquivar"}}</button>{{/if}}
      {{#if showHeal}}<button type="button" data-action="healAlly" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Habilidade.Curar"}}</button>{{/if}}
      {{#if showCompanion}}<label class="desordem-ficha__campo"><input type="checkbox" name="system.cena.animalFerido" {{#if animalFerido}}checked{{/if}} {{#if locked}}disabled{{/if}}> <span>{{localize "DESORDEM.Habilidade.AnimalFeridoMarca"}}</span></label>{{/if}}
      {{#if showSneak}}<label class="desordem-ficha__campo"><input type="checkbox" data-ativa="sorrateiro" {{#if sorrateiroAtivo}}checked{{/if}} {{#if locked}}disabled{{/if}}> <span>{{localize "DESORDEM.Habilidade.Sorrateiro"}}</span></label>{{/if}}
    </div>
  </div>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.SemHabilidades"}}</p>
  {{/each}}
  {{#if editable}}
  <button type="button" data-action="createItem" data-type="habilidade">{{localize "DESORDEM.Item.Novo.habilidade"}}</button>
  <button type="button" data-action="newScene">{{localize "DESORDEM.Habilidade.NovaCena"}}</button>
  {{/if}}
</section>

<section class="desordem-ficha__secao desordem-ficha__efeitos">
  <h3>{{localize "DESORDEM.Ficha.Efeitos"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaEfeitos"}}</p>

  {{#each lesions}}
  <div class="desordem-efeito-ativo">
    <span class="desordem-efeito-ativo__origem">{{localize "DESORDEM.Ficha.EfeitoOrigem.lesao"}}</span>
    <span class="desordem-efeito-ativo__texto"><strong>{{label}}{{#if repeated}} ×{{count}}{{/if}}</strong> — {{description}}</span>
    {{#if ../editable}}<button type="button" class="desordem-ficha__remover" data-action="removeLesion" data-lesion="{{key}}" title="{{localize "DESORDEM.Ficha.RemoverLesao"}}">×</button>{{/if}}
  </div>
  {{/each}}
  {{#each traumas}}
  <div class="desordem-efeito-ativo">
    <span class="desordem-efeito-ativo__origem">{{localize "DESORDEM.Ficha.EfeitoOrigem.trauma"}}</span>
    <span class="desordem-efeito-ativo__texto"><strong>{{label}}{{#if repeated}} ×{{count}}{{/if}}</strong> — {{description}}</span>
    {{#if ../editable}}<button type="button" class="desordem-ficha__remover" data-action="removeTrauma" data-trauma="{{key}}" title="{{localize "DESORDEM.Ficha.RemoverTrauma"}}">×</button>{{/if}}
  </div>
  {{/each}}

  {{#each effects}}
  <div class="desordem-efeito">
    <span class="desordem-efeito-ativo__origem">{{localize "DESORDEM.Ficha.EfeitoOrigem.efeito"}}</span>
    <input type="text" class="desordem-efeito__nome" data-efeito-campo="nome" data-index="{{index}}" value="{{nome}}" title="{{descricao}}" placeholder="{{localize "DESORDEM.Ficha.EfeitoNome"}}" {{#if locked}}disabled{{/if}}>
    <select data-efeito-campo="atributo" data-index="{{index}}" {{#if locked}}disabled{{/if}}>{{#each attrOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <select data-efeito-campo="passos" data-index="{{index}}" title="{{localize "DESORDEM.Ficha.EfeitoPassos"}}" {{#if locked}}disabled{{/if}}>{{#each stepOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <label class="desordem-item-linha__marca"><input type="checkbox" data-efeito-campo="fimDeCena" data-index="{{index}}" {{#if fimDeCena}}checked{{/if}} {{#if locked}}disabled{{/if}}> {{localize "DESORDEM.Ficha.EfeitoFimDeCena"}}</label>
    <input type="text" class="desordem-efeito__descricao" data-efeito-campo="descricao" data-index="{{index}}" value="{{descricao}}" placeholder="{{localize "DESORDEM.Ficha.EfeitoDescricao"}}" {{#if locked}}disabled{{/if}}>
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="removeEffect" data-index="{{index}}" title="{{localize "DESORDEM.Ficha.RemoverEfeito"}}">×</button>{{/unless}}
  </div>
  {{/each}}
  {{#unless lesions.length}}{{#unless traumas.length}}{{#unless effects.length}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.SemEfeitos"}}</p>{{/unless}}{{/unless}}{{/unless}}
  {{#if editable}}<button type="button" data-action="addEffect">{{localize "DESORDEM.Ficha.AdicionarEfeito"}}</button>{{/if}}
</section>

<section class="desordem-ficha__secao desordem-ficha__equipamento">
  <h3>{{localize "DESORDEM.Ficha.Equipamento"}}</h3>
  <p class="desordem-ficha__dica">
    {{localize "DESORDEM.Ficha.ArmaduraResumo" restantes=equipment.armorTotals.available total=equipment.armorTotals.total}}
    · {{localize "DESORDEM.Ficha.MaosEmUso" usadas=equipment.hands.used}}{{#if equipment.hands.over}} <strong class="desordem-ficha__alerta">{{localize "DESORDEM.Ficha.MaosDemais"}}</strong>{{/if}}
  </p>

  <h4>{{localize "DESORDEM.Ficha.Armas"}}</h4>
  {{#each equipment.weapons}}
  <div class="desordem-item-linha" data-item-id="{{id}}" draggable="true">
    <label class="desordem-item-linha__marca"><input type="checkbox" data-item-campo="empunhada" data-item-id="{{id}}" {{#if empunhada}}checked{{/if}} {{#if blocked}}disabled title="{{localize "DESORDEM.Equipamento.Bloqueio.maos"}}"{{/if}}> {{localize "DESORDEM.Item.Empunhada"}}</label>
    <span class="desordem-item-linha__nome" title="{{descricao}}"><strong>{{name}}</strong> — {{kindLabel}}, {{handsLabel}}, {{localize "DESORDEM.Ficha.Dano"}} {{damageLabel}}{{#if naoLetal}} ({{localize "DESORDEM.Dano.NaoLetal"}}){{/if}} · {{skillLabel}}</span>
    <button type="button" data-action="attackWeapon" data-item-id="{{id}}" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Ficha.Atacar"}}</button>
    <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
  </div>
  {{/each}}
  {{#if editable}}<button type="button" data-action="createItem" data-type="arma">{{localize "DESORDEM.Item.Novo.arma"}}</button>{{/if}}

  <h4>{{localize "DESORDEM.Ficha.Armaduras"}}</h4>
  {{#each equipment.armors}}
  <div class="desordem-item-linha" data-item-id="{{id}}" draggable="true">
    <label class="desordem-item-linha__marca"><input type="checkbox" data-item-campo="vestida" data-item-id="{{id}}" {{#if vestida}}checked{{/if}} {{#if blocked}}disabled title="{{localize "DESORDEM.Equipamento.Bloqueio.armadura"}}"{{/if}}> {{localize "DESORDEM.Item.Vestida"}}</label>
    <span class="desordem-item-linha__nome" title="{{descricao}}"><strong>{{name}}</strong> — {{localize "DESORDEM.Ficha.PontosArmadura" restantes=restantes pontos=pontos}}</span>
    <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
  </div>
  {{/each}}
  {{#if editable}}<button type="button" data-action="createItem" data-type="armadura">{{localize "DESORDEM.Item.Novo.armadura"}}</button>{{/if}}

  <h4>{{localize "DESORDEM.Ficha.Itens"}}</h4>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaItens"}}</p>
  {{#each equipment.others}}
  <div class="desordem-item-linha" data-item-id="{{id}}" draggable="true">
    <label class="desordem-item-linha__marca"><input type="checkbox" data-item-campo="empunhada" data-item-id="{{id}}" {{#if empunhada}}checked{{/if}} {{#if blocked}}disabled title="{{localize "DESORDEM.Equipamento.Bloqueio.maos"}}"{{/if}}> {{localize "DESORDEM.Item.NaMao"}}</label>
    <span class="desordem-item-linha__nome" title="{{descricao}}"><strong>{{name}}</strong> — {{handsLabel}}</span>
    <label class="desordem-item-linha__marca">{{localize "DESORDEM.Item.Quantidade"}} <input type="number" class="desordem-item-linha__numero" data-item-campo="quantidade" data-item-id="{{id}}" value="{{quantidade}}" min="0" {{#if locked}}disabled{{/if}}></label>
    {{#if hasUsos}}<label class="desordem-item-linha__marca">{{localize "DESORDEM.Item.Usos"}} <input type="number" class="desordem-item-linha__numero" data-item-campo="usos" data-item-id="{{id}}" value="{{usos}}" min="0" max="{{usosMax}}" {{#if locked}}disabled{{/if}}> / {{usosMax}}</label>{{/if}}
    {{#if showUse}}<button type="button" data-action="useItem" data-item-id="{{id}}" {{#unless canUse}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.Usar"}}</button>{{/if}}
    <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
  </div>
  {{/each}}
  {{#if editable}}<button type="button" data-action="createItem" data-type="item">{{localize "DESORDEM.Item.Novo.item"}}</button>{{/if}}
</section>

<section class="desordem-ficha__secao desordem-ficha__relacoes">
  <h3>{{localize "DESORDEM.Ficha.Relacoes"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaRelacoes"}}</p>
  {{#each relations}}
  <div class="desordem-relacao {{#if usada}}desordem-relacao--usada{{/if}}">
    <span class="desordem-relacao__grau" title="{{grauLabel}}">
      {{#each dots}}<button type="button" class="desordem-relacao__bolinha {{#if filled}}desordem-relacao__bolinha--cheia{{/if}}" data-action="setRelationDegree" data-index="{{../index}}" data-degree="{{n}}" {{#if ../locked}}disabled{{/if}}>{{#if filled}}●{{else}}○{{/if}}</button>{{/each}}
    </span>
    <input type="text" class="desordem-relacao__pessoa" data-relacao-campo="pessoa" data-index="{{index}}" value="{{pessoa}}" placeholder="{{localize "DESORDEM.Ficha.RelacaoPessoa"}}" {{#if locked}}disabled{{/if}}>
    <input type="text" class="desordem-relacao__descricao" data-relacao-campo="descricao" data-index="{{index}}" value="{{descricao}}" placeholder="{{localize "DESORDEM.Ficha.RelacaoDescricao"}}" {{#if locked}}disabled{{/if}}>
    <label class="desordem-relacao__usada"><input type="checkbox" data-relacao-campo="usada" data-index="{{index}}" {{#if usada}}checked{{/if}} {{#if locked}}disabled{{/if}}> {{localize "DESORDEM.Ficha.LacoUsado"}}</label>
    {{#if showInvoke}}<button type="button" data-action="invokeRelation" data-index="{{index}}" {{#unless canInvoke}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.Invocar"}}</button>{{/if}}
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="removeRelation" data-index="{{index}}" title="{{localize "DESORDEM.Ficha.RemoverRelacao"}}">×</button>{{/unless}}
  </div>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.SemRelacoes"}}</p>
  {{/each}}
  {{#if editable}}<button type="button" data-action="addRelation">{{localize "DESORDEM.Ficha.AdicionarRelacao"}}</button>{{/if}}
</section>

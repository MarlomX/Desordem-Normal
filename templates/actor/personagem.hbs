<div class="desordem-ficha">
<header class="desordem-ficha__cabecalho">
  <img class="desordem-ficha__retrato" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">

  <div class="desordem-ficha__identidade">
    <input class="desordem-ficha__nome" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.Nivel"}}</span>
      <input type="number" name="system.nivel" value="{{system.nivel}}" min="1" max="10" {{#unless editable}}disabled{{/unless}}>
    </label>
  </div>

  <div class="desordem-ficha__recursos">
    <div class="desordem-ficha__recurso">
      <span>{{localize "DESORDEM.Ficha.PV"}}</span>
      <input type="number" name="system.pv.value" value="{{system.pv.value}}" min="0" {{#unless editable}}disabled{{/unless}}>
      <span>/</span>
      <input type="number" name="system.pv.max" value="{{system.pv.max}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="desordem-ficha__recurso">
      <span>{{localize "DESORDEM.Ficha.PD"}}</span>
      <input type="number" name="system.pd.value" value="{{system.pd.value}}" min="0" {{#unless editable}}disabled{{/unless}}>
      <span>/</span>
      <input type="number" name="system.pd.max" value="{{system.pd.max}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>
</header>

<section class="desordem-ficha__secao desordem-ficha__saude">
  <h3>{{localize "DESORDEM.Ficha.Saude"}}</h3>

  <div class="desordem-ficha__estado">
    <label><input type="checkbox" name="system.estado.inconsciente" {{#if system.estado.inconsciente}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.inconsciente"}}</label>
    <label><input type="checkbox" name="system.estado.moribundo" {{#if system.estado.moribundo}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.moribundo"}}</label>
    <label><input type="checkbox" name="system.estado.morteLenta" {{#if system.estado.morteLenta}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morteLenta"}}</label>
    <label><input type="checkbox" name="system.estado.contusao" {{#if system.estado.contusao}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.contusao"}}</label>
    <label><input type="checkbox" name="system.estado.morto" {{#if system.estado.morto}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.Estado.morto"}}</label>
  </div>

  <div class="desordem-ficha__acoes-saude">
    <label class="desordem-ficha__campo">
      <span>{{localize "DESORDEM.Ficha.Dano"}}</span>
      <input type="number" data-dano min="0" value="0" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo">
      <input type="checkbox" data-nao-letal {{#unless editable}}disabled{{/unless}}>
      <span>{{localize "DESORDEM.Ficha.NaoLetal"}}</span>
    </label>
    <button type="button" data-action="applyDamage" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.AplicarDano"}}</button>
    <button type="button" data-action="rollInjury" {{#unless editable}}disabled{{/unless}}>{{localize "DESORDEM.Ficha.TesteLesao"}} ({{localize "DESORDEM.Teste.DT"}} {{nextInjuryDT}})</button>
  </div>

  <label class="desordem-ficha__campo">
    <span>{{localize "DESORDEM.Ficha.TestesLesaoCena"}}</span>
    <input type="number" name="system.cena.testesLesao" value="{{system.cena.testesLesao}}" min="0" {{#unless editable}}disabled{{/unless}}>
  </label>

  <div class="desordem-ficha__lesoes">
    <strong>{{localize "DESORDEM.Ficha.Lesoes"}}:</strong>
    {{#each lesions}}
    <span class="desordem-ficha__lesao">{{label}}{{#if repeated}} ×{{count}}{{/if}}
      {{#if ../editable}}<button type="button" class="desordem-ficha__remover" data-action="removeLesion" data-lesion="{{key}}" title="{{localize "DESORDEM.Ficha.RemoverLesao"}}">×</button>{{/if}}
    </span>
    {{else}}
    <span class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.SemLesoes"}}</span>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Atributos"}}</h3>
  <div class="desordem-ficha__atributos">
    {{#each attributes}}
    <label class="desordem-ficha__campo">
      <span>{{label}}</span>
      <select name="system.atributos.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Pericias"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaRolagem"}}</p>
  <div class="desordem-ficha__pericias">
    {{#each skills}}
    <div class="desordem-ficha__pericia">
      <button type="button" class="desordem-ficha__rolar" data-action="rollSkill" data-skill="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{attrLabel}}</span>
      </button>
      <select name="system.pericias.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    {{/each}}
  </div>
</section>

<section class="desordem-ficha__secao">
  <h3>{{localize "DESORDEM.Ficha.Aptidoes"}}</h3>
  <div class="desordem-ficha__pericias">
    {{#each aptitudes}}
    <div class="desordem-ficha__pericia">
      <button type="button" class="desordem-ficha__rolar" data-action="rollAptitude" data-aptitude="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <select name="system.aptidoes.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    {{/each}}
  </div>
</section>
</div>

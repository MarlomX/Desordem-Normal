<section class="desordem-aba{{#if tabState.testes}} is-active{{/if}}" data-tab-panel="testes">
{{#if system.estado.pavor}}
<div class="desordem-ficha__secao desordem-ficha__pavor-rapido">
  <label><input type="checkbox" data-controlar-pavor {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.ControlarPavor"}}</label>
  <label><input type="checkbox" data-abracar-pavor {{#unless editable}}disabled{{/unless}}> {{localize "DESORDEM.Ficha.AbracarPavor"}}</label>
  <span class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaPavor"}}</span>
</div>
{{/if}}
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-user" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Atributos"}}</h3>
  <div class="desordem-ficha__atributos">
    {{#each attributes}}
    <div class="desordem-atributo">
      <span class="desordem-atributo__nome">{{label}}
        {{#if stepNet}}<span class="desordem-passo desordem-passo--{{stepDirection}}" title="{{localize "DESORDEM.Ficha.Passos.Efeito" base=die atual=shownDie}}"><i class="fa-solid {{#if stepUp}}fa-arrow-up{{else}}fa-arrow-down{{/if}}" aria-hidden="true"></i>{{#if stepBig}}<sub>{{stepAbs}}</sub>{{/if}}</span>{{/if}}
      </span>
      <span class="desordem-forma desordem-forma--grande desordem-d-{{shownDie}}{{#if stepNet}} is-passo is-passo--{{stepDirection}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.atributos.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
          {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
      {{#if ../editable}}
      <span class="desordem-passos-ctl" title="{{localize "DESORDEM.Ficha.Passos.Atributo"}}">
        <button type="button" data-action="stepSteps" data-key="{{key}}" data-delta="-1" aria-label="{{localize "DESORDEM.Ficha.Passos.Menos"}}">−</button>
        <button type="button" data-action="stepSteps" data-key="{{key}}" data-delta="1" aria-label="{{localize "DESORDEM.Ficha.Passos.Mais"}}">+</button>
      </span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Pericias"}}</h3>
  <div class="desordem-passos-geral{{#if skillStep.net}} is-passo{{/if}}">
    <span class="desordem-passos-geral__nome">{{localize "DESORDEM.Ficha.Passos.Pericias"}}</span>
    <span class="desordem-passos-ctl">
      <button type="button" data-action="stepSteps" data-key="pericias" data-delta="-1" {{#unless editable}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Menos"}}">−</button>
      <button type="button" class="desordem-passos-ctl__valor" data-action="stepSteps" data-key="pericias" data-reset="true" {{#unless editable}}disabled{{/unless}} title="{{localize "DESORDEM.Ficha.Passos.Zerar"}}">{{skillStep.net}}</button>
      <button type="button" data-action="stepSteps" data-key="pericias" data-delta="1" {{#unless editable}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Mais"}}">+</button>
    </span>
  </div>
  <div class="desordem-filtro">
    <label class="desordem-filtro__busca"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-filtro-texto placeholder="{{localize "DESORDEM.Ficha.Filtro.Placeholder"}}" autocomplete="off"></label>
    <label class="desordem-filtro__treinadas"><input type="checkbox" data-filtro-treinadas> <span>{{localize "DESORDEM.Ficha.Filtro.Treinadas"}}</span></label>
  </div>
  <p class="desordem-ficha__dica" data-filtro-vazio hidden>{{localize "DESORDEM.Ficha.Filtro.SemResultados"}}</p>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaRolagem"}}</p>
  <div class="desordem-ficha__pericias">
    {{#each skills}}
    <div class="desordem-ficha__pericia{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-dado="{{die}}">
      <button type="button" class="desordem-ficha__rolar" data-action="rollSkill" data-skill="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{attrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{attrShownDie}}{{#if attrShifted}} is-passo{{/if}}" title="{{attrLabel}}"><span class="desordem-forma__valor">{{attrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.pericias.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </div>
    {{/each}}
  </div>
</section>
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Aptidoes"}}</h3>
  <div class="desordem-ficha__pericias">
    {{#each aptitudes}}
    <div class="desordem-ficha__pericia{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-dado="{{die}}">
      <button type="button" class="desordem-ficha__rolar" data-action="rollAptitude" data-aptitude="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{../aptitudeAttrShownDie}}{{#if ../aptitudeAttrShifted}} is-passo{{/if}}" title="{{../aptitudeAttrLabel}}"><span class="desordem-forma__valor">{{../aptitudeAttrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.aptidoes.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </div>
    {{/each}}
  </div>
</section>
</section>

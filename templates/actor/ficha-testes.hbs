<section class="desordem-aba{{#if tabState.testes}} is-active{{/if}}" data-tab-panel="testes">
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-user" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Atributos"}}</h3>
  <div class="desordem-ficha__atributos">
    {{#each attributes}}
    <div class="desordem-atributo">
      <span class="desordem-atributo__nome">{{label}}
        {{#if stepNet}}<span class="desordem-passo desordem-passo--{{stepDirection}}" title="{{localize "DESORDEM.Ficha.Passos.Efeito" base=die atual=shownDie}}"><i class="fa-solid {{#if stepUp}}fa-arrow-up{{else}}fa-arrow-down{{/if}}" aria-hidden="true"></i>{{#if stepBig}}<sub>{{stepAbs}}</sub>{{/if}}</span>{{/if}}
      </span>
      <span class="desordem-forma desordem-forma--grande desordem-d-{{shownDie}}{{#if stepNet}} is-passo is-passo--{{stepDirection}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.atributos.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
          {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
      {{#if ../editable}}
      <span class="desordem-passos-ctl" title="{{localize "DESORDEM.Ficha.Passos.Atributo"}}">
        <button type="button" data-action="stepSteps" data-key="{{key}}" data-delta="-1" {{#unless canStepDown}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Menos"}}">−</button>
        <button type="button" data-action="stepSteps" data-key="{{key}}" data-delta="1" {{#unless canStepUp}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Mais"}}">+</button>
      </span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Pericias"}}</h3>
  <div class="desordem-passos-geral{{#if skillStep.net}} is-passo is-passo--{{skillStep.direction}}{{/if}}">
    <span class="desordem-passos-geral__nome">{{localize "DESORDEM.Ficha.Passos.Pericias"}}</span>
    <span class="desordem-passos-ctl">
      <button type="button" data-action="stepSteps" data-key="pericias" data-delta="-1" {{#unless editable}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Menos"}}">−</button>
      <button type="button" class="desordem-passos-ctl__valor" data-action="stepSteps" data-key="pericias" data-reset="true" {{#unless editable}}disabled{{/unless}} title="{{localize "DESORDEM.Ficha.Passos.Zerar"}}">{{skillStep.net}}</button>
      <button type="button" data-action="stepSteps" data-key="pericias" data-delta="1" {{#unless editable}}disabled{{/unless}} aria-label="{{localize "DESORDEM.Ficha.Passos.Mais"}}">+</button>
    </span>
  </div>
  <div class="desordem-filtro">
    <label class="desordem-filtro__busca"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-filtro-texto placeholder="{{localize "DESORDEM.Ficha.Filtro.Placeholder"}}" autocomplete="off"></label>
    <label class="desordem-filtro__ordenar"><span>{{localize "DESORDEM.Ficha.Ordenar.Titulo"}}</span>
      <select data-ordenar>
        <option value="nome">{{localize "DESORDEM.Ficha.Ordenar.Nome"}}</option>
        <option value="dado">{{localize "DESORDEM.Ficha.Ordenar.Dado"}}</option>
      </select>
    </label>
  </div>
  <p class="desordem-ficha__dica" data-filtro-vazio hidden>{{localize "DESORDEM.Ficha.Filtro.SemResultados"}}</p>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.DicaRolagem"}}</p>
  <div class="desordem-ficha__pericias">
    {{#each skills}}
    <div class="desordem-ficha__pericia desordem-d-{{shownDie}}{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-nome="{{label}}" data-dado-final="{{shownDie}}" data-dado-attr="{{attrShownDie}}">
      <button type="button" class="desordem-ficha__rolar" data-action="rollSkill" data-skill="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{attrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{attrShownDie}}{{#if attrShifted}} is-passo is-passo--{{attrShiftDir}}{{/if}}" title="{{attrLabel}}"><span class="desordem-forma__valor">{{attrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo is-passo--{{shiftDir}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.pericias.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </div>
    {{/each}}
  </div>
</section>
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Aptidoes"}}</h3>
  <div class="desordem-ficha__pericias">
    {{#each aptitudes}}
    <div class="desordem-ficha__pericia desordem-d-{{shownDie}}{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-nome="{{label}}" data-dado-final="{{shownDie}}" data-dado-attr="{{../aptitudeAttrShownDie}}">
      <button type="button" class="desordem-ficha__rolar" data-action="rollAptitude" data-aptitude="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{../aptitudeAttrShownDie}}{{#if ../aptitudeAttrShifted}} is-passo is-passo--{{../aptitudeAttrShiftDir}}{{/if}}" title="{{../aptitudeAttrLabel}}"><span class="desordem-forma__valor">{{../aptitudeAttrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo is-passo--{{shiftDir}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.aptidoes.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </div>
    {{/each}}
    {{#each aptitudeExtras}}
    <div class="desordem-ficha__pericia desordem-ficha__pericia--extra desordem-d-{{shownDie}}{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-nome="{{label}}" data-dado-final="{{shownDie}}" data-dado-attr="{{../aptitudeAttrShownDie}}">
      <input type="text" class="desordem-extra__nome" data-extra-campo="nome" data-group="aptidao" data-id="{{id}}" value="{{nome}}" maxlength="40" placeholder="{{localize "DESORDEM.Ficha.ExtraNome.aptidao"}}" {{#unless ../editable}}disabled{{/unless}}>
      <button type="button" class="desordem-ficha__rolar desordem-ficha__rolar--extra" data-action="rollAptitude" data-aptitude="{{key}}" title="{{label}}">
        <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{../aptitudeAttrShownDie}}{{#if ../aptitudeAttrShifted}} is-passo is-passo--{{../aptitudeAttrShiftDir}}{{/if}}" title="{{../aptitudeAttrLabel}}"><span class="desordem-forma__valor">{{../aptitudeAttrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo is-passo--{{shiftDir}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" data-extra-campo="dado" data-group="aptidao" data-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
      {{#if ../editable}}<button type="button" class="desordem-ficha__remover" data-action="removeExtra" data-group="aptidao" data-id="{{id}}" title="{{localize "DESORDEM.Ficha.RemoverExtra.aptidao"}}">×</button>{{/if}}
    </div>
    {{/each}}
  </div>
  {{#if editable}}<button type="button" class="desordem-extra__adicionar" data-action="addExtra" data-group="aptidao" {{#unless canAddAptitude}}disabled title="{{localize "DESORDEM.Ficha.LimiteExtras" max=maxExtras}}"{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.AdicionarAptidao"}}</button>{{/if}}
</section>
<section class="desordem-ficha__secao">
  <h3><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Oficios"}}</h3>
  <div class="desordem-ficha__pericias">
    {{#each crafts}}
    <div class="desordem-ficha__pericia desordem-d-{{shownDie}}{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-nome="{{label}}" data-dado-final="{{shownDie}}" data-dado-attr="{{../aptitudeAttrShownDie}}">
      <button type="button" class="desordem-ficha__rolar" data-action="rollCraft" data-craft="{{key}}">
        <span class="desordem-ficha__pericia-nome">{{label}}</span>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{../aptitudeAttrShownDie}}{{#if ../aptitudeAttrShifted}} is-passo is-passo--{{../aptitudeAttrShiftDir}}{{/if}}" title="{{../aptitudeAttrLabel}}"><span class="desordem-forma__valor">{{../aptitudeAttrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo is-passo--{{shiftDir}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" name="system.oficios.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
    </div>
    {{/each}}
    {{#each craftExtras}}
    <div class="desordem-ficha__pericia desordem-ficha__pericia--extra desordem-d-{{shownDie}}{{#unless trained}} is-destreinada{{/unless}}" data-busca="{{search}}" data-nome="{{label}}" data-dado-final="{{shownDie}}" data-dado-attr="{{../aptitudeAttrShownDie}}">
      <input type="text" class="desordem-extra__nome" data-extra-campo="nome" data-group="oficio" data-id="{{id}}" value="{{nome}}" maxlength="40" placeholder="{{localize "DESORDEM.Ficha.ExtraNome.oficio"}}" {{#unless ../editable}}disabled{{/unless}}>
      <button type="button" class="desordem-ficha__rolar desordem-ficha__rolar--extra" data-action="rollCraft" data-craft="{{key}}" title="{{label}}">
        <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
        <span class="desordem-ficha__pericia-attr">{{../aptitudeAttrLabel}}</span>
      </button>
      <span class="desordem-forma desordem-d-{{../aptitudeAttrShownDie}}{{#if ../aptitudeAttrShifted}} is-passo is-passo--{{../aptitudeAttrShiftDir}}{{/if}}" title="{{../aptitudeAttrLabel}}"><span class="desordem-forma__valor">{{../aptitudeAttrShownDie}}</span></span>
      <span class="desordem-ficha__soma">+</span>
      <span class="desordem-forma desordem-d-{{shownDie}}{{#if shifted}} is-passo is-passo--{{shiftDir}}{{/if}}">
        <span class="desordem-forma__valor">{{shownDie}}</span>
        <select class="desordem-forma__select" data-extra-campo="dado" data-group="oficio" data-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </span>
      {{#if ../editable}}<button type="button" class="desordem-ficha__remover" data-action="removeExtra" data-group="oficio" data-id="{{id}}" title="{{localize "DESORDEM.Ficha.RemoverExtra.oficio"}}">×</button>{{/if}}
    </div>
    {{/each}}
  </div>
  {{#if editable}}<button type="button" class="desordem-extra__adicionar" data-action="addExtra" data-group="oficio" {{#unless canAddCraft}}disabled title="{{localize "DESORDEM.Ficha.LimiteExtras" max=maxExtras}}"{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.AdicionarOficio"}}</button>{{/if}}
</section>
</section>

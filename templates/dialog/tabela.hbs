<div class="desordem-tabela-janela">
  <p class="desordem-pre__titulo">{{titulo}}</p>

  <div class="desordem-tabela-janela__dados" aria-live="polite" data-lados="{{sides}}">
    {{#each dice}}
    <span class="desordem-forma desordem-forma--grande desordem-d-{{../sides}}" data-dado>
      <span class="desordem-forma__valor" data-valor>{{../sides}}</span>
    </span>
    {{/each}}
  </div>

  {{#if aviso}}<p class="desordem-ficha__dica">{{aviso}}</p>{{/if}}

  {{#if manual}}
  <label class="desordem-tabela-janela__manual">
    <span>{{manual.label}}</span>
    <select name="manual">
      <option value="">{{manual.rollOption}}</option>
      {{#each manual.options}}<option value="{{n}}">{{n}} · {{label}}</option>{{/each}}
    </select>
  </label>
  {{/if}}
</div>

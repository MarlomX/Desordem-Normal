{{!-- Janela de um efeito da aba Condição (sheets/condition-effect-app.js): nome, duração,
  descrição e o editor de efeitos do catálogo (o mesmo da ficha do item). --}}
<div class="desordem-efeito-janela__corpo">
  {{#unless missing}}
  {{#if fromAbility}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Ficha.EfeitoJanela.DicaHabilidade"}}</p>{{/if}}
  <div class="desordem-item__campos">
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Ficha.EfeitoNome"}}</span>
      <input type="text" data-condicao-campo="nome" value="{{effect.nome}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Efeito.Duracao.Titulo"}}</span>
      <select data-condicao-campo="duracao" {{#unless editable}}disabled{{/unless}}>{{#each durationChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
  </div>
  <label class="desordem-ficha__campo desordem-item__descricao"><span>{{localize "DESORDEM.Ficha.EfeitoDescricao"}}</span>
    <textarea data-condicao-campo="descricao" rows="3" {{#unless editable}}disabled{{/unless}}>{{effect.descricao}}</textarea>
  </label>
  {{> "desordem-normal.efeitos-editor"}}
  {{/unless}}
</div>

<div class="desordem-oposto-escolha">
  {{#if opponentName}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Oposto.Contra" nome=opponentName}}</p>{{else}}{{#if showDescription}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Oposto.ContraQualquer"}}</p>{{/if}}{{/if}}
  {{#if note}}<p class="desordem-ficha__dica">{{note}}</p>{{/if}}
  {{#if showWeapon}}
  <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Oposto.Arma"}}</span>
    <select name="weapon">{{#each weapons}}<option value="{{id}}">{{nome}} ({{label}})</option>{{/each}}</select>
  </label>
  {{/if}}
  {{#if showSkill}}
  <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Oposto.Pericia"}}</span>
    <select name="skill">{{#each skills}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </label>
  {{/if}}
  {{#if showDescription}}
  <label class="desordem-ficha__campo"><span>{{localize "DESORDEM.Oposto.Descricao"}}</span>
    <input type="text" name="descricao" maxlength="120" placeholder="{{localize "DESORDEM.Oposto.DescricaoDica"}}">
  </label>
  {{/if}}
</div>

<div class="desordem-pre">
  <p class="desordem-pre__titulo">{{titulo}}</p>

  <div class="desordem-pre__previa" data-previa aria-live="polite"></div>

  {{#if showDt}}
  <div class="desordem-pre__dt">
    <span class="desordem-pre__dt-nome">{{localize "DESORDEM.Teste.Pre.DT"}}</span>
    <span class="desordem-passos-ctl">
      <button type="button" data-dt-passo="-1" aria-label="{{localize "DESORDEM.Teste.Pre.DTMenos"}}">−</button>
      <input type="number" name="dt" min="1" max="99" step="1" value="{{dt}}" inputmode="numeric">
      <button type="button" data-dt-passo="1" aria-label="{{localize "DESORDEM.Teste.Pre.DTMais"}}">+</button>
    </span>
  </div>
  {{/if}}

  <fieldset class="desordem-pre__grupo">
    <legend><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Bonus.Titulo"}}</legend>
    <div class="desordem-bonus__slots" data-slots></div>
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Teste.Pre.DicaEspacos"}}</p>
  </fieldset>

  <fieldset class="desordem-pre__grupo">
    <legend><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "DESORDEM.Teste.Pre.Habilidades"}}</legend>
    {{#each abilities}}
    <label class="desordem-pre__opcao{{#unless available}} is-indisponivel{{/unless}}" data-opcao="{{key}}">
      <input type="checkbox" name="active" value="{{key}}" {{#unless available}}disabled{{/unless}}>
      <span class="desordem-pre__nome">{{label}}</span>
      <span class="desordem-pre__custo">{{costText}}</span>
      {{#if reasonText}}<span class="desordem-pre__motivo">{{reasonText}}</span>{{/if}}
      <span class="desordem-pre__motivo" data-motivo></span>
    </label>
    {{else}}
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Teste.Pre.SemHabilidades"}}</p>
    {{/each}}
  </fieldset>

  {{#if fear}}
  <fieldset class="desordem-pre__grupo">
    <legend><i class="fa-solid fa-ghost" aria-hidden="true"></i> {{fear.title}}</legend>
    <label class="desordem-pre__opcao{{#unless fear.controlPossible}} is-indisponivel{{/unless}}">
      <input type="checkbox" name="controlFear" {{#unless fear.controlPossible}}disabled{{/unless}}>
      <span class="desordem-pre__nome">{{localize "DESORDEM.Ficha.ControlarPavor"}}</span>
      <span class="desordem-pre__custo">{{fear.controlText}}</span>
    </label>
    <label class="desordem-pre__opcao" data-opcao="embrace">
      <input type="checkbox" name="embraceFear">
      <span class="desordem-pre__nome">{{localize "DESORDEM.Ficha.AbracarPavor"}}</span>
      <span class="desordem-pre__custo">{{fear.embraceText}}</span>
      <span class="desordem-pre__motivo" data-motivo></span>
    </label>
  </fieldset>
  {{/if}}

  <div class="desordem-pre__custos" data-custos></div>
  <p class="desordem-pre__erro" data-erro></p>
</div>

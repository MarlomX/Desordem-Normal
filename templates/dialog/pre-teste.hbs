<div class="desordem-pre">
  <p class="desordem-pre__titulo">{{titulo}}</p>

  <div class="desordem-pre__previa" data-previa aria-live="polite"></div>

  {{#if showDt}}
  <div class="desordem-pre__dt" data-dt-bloco>
    <span class="desordem-pre__dt-nome">{{localize "DESORDEM.Teste.Pre.DT"}}</span>
    <span class="desordem-passos-ctl">
      <button type="button" data-dt-passo="-1" aria-label="{{localize "DESORDEM.Teste.Pre.DTMenos"}}">−</button>
      <input type="number" name="dt" min="1" max="99" step="1" value="{{dt}}" inputmode="numeric">
      <button type="button" data-dt-passo="1" aria-label="{{localize "DESORDEM.Teste.Pre.DTMais"}}">+</button>
    </span>
  </div>
  {{/if}}

  {{#if temFurtividade}}
  {{! Seção de furtividade: uma opção por vez. «Teste comum» desmarca as demais. }}
  <fieldset class="desordem-pre__grupo" data-esconderijo>
    <legend><i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{localize "DESORDEM.Furtividade.Pre.Titulo"}}</legend>
    <label class="desordem-pre__opcao">
      <input type="radio" name="furtivaAcao" value="" checked>
      <span class="desordem-pre__nome">{{localize "DESORDEM.Furtividade.Pre.Comum"}}</span>
    </label>
    {{#if esconderijo}}
    <label class="desordem-pre__opcao">
      <input type="radio" name="furtivaAcao" value="teste">
      <span class="desordem-pre__nome">{{localize "DESORDEM.Furtividade.Pre.Usar"}}</span>
      <span class="desordem-pre__custo">{{localize "DESORDEM.Furtividade.Pre.Regra"}}</span>
    </label>
    {{/if}}
    {{#if furtiva.esconderTexto}}
    <label class="desordem-pre__opcao">
      <input type="radio" name="furtivaAcao" value="esconder">
      <span class="desordem-pre__nome">{{furtiva.esconderTexto}}</span>
      <span class="desordem-pre__custo">{{localize "DESORDEM.Furtividade.Pre.EsconderRegra"}}</span>
    </label>
    {{/if}}
    {{#if furtiva.distrairTexto}}
    <label class="desordem-pre__opcao">
      <input type="radio" name="furtivaAcao" value="distrair">
      <span class="desordem-pre__nome">{{furtiva.distrairTexto}}</span>
      <span class="desordem-pre__custo">{{localize "DESORDEM.Furtividade.Pre.DistrairRegra"}}</span>
    </label>
    <label class="desordem-pre__avanco-campo is-oculta" data-furtiva-destino>
      <span>{{localize "DESORDEM.Furtividade.Pre.Destino"}}</span>
      <select name="furtivaDestino">
        {{#each furtiva.destinos}}<option value="{{id}}">{{name}}</option>{{/each}}
      </select>
    </label>
    {{/if}}
  </fieldset>
  {{/if}}

  {{#if avanco}}
  <fieldset class="desordem-pre__grupo" data-avanco data-dt="{{avanco.dt}}"{{#if avanco.motivo}} data-bloqueado="1"{{/if}}>
    <legend><i class="fa-solid fa-person-running" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Pre.Titulo"}}</legend>
    <label class="desordem-pre__opcao{{#if avanco.motivo}} is-indisponivel{{/if}}">
      <input type="checkbox" name="avancoOn" {{#if avanco.motivo}}disabled{{/if}}>
      <span class="desordem-pre__nome">{{localize "DESORDEM.Perseguicao.Pre.Usar"}}</span>
      <span class="desordem-pre__custo">{{localize "DESORDEM.Perseguicao.Pre.Regra"}}</span>
      {{#if avanco.motivo}}<span class="desordem-pre__motivo">{{avanco.motivo}}</span>{{/if}}
    </label>
    {{#if avanco.aviso}}<p class="desordem-ficha__dica desordem-pre__aviso">{{avanco.aviso}}</p>{{/if}}
    {{#unless avanco.motivo}}
    <div class="desordem-pre__avanco is-oculta" data-avanco-detalhes>
      {{#if avanco.hasBreath}}
      <label class="desordem-pre__avanco-campo">
        <span>{{localize "DESORDEM.Perseguicao.Pre.Folego" n=avanco.folego}}</span>
        <select name="avancoBreath">
          {{#each avanco.breathOptions}}
          <option value="{{n}}">{{n}}d6</option>
          {{/each}}
        </select>
      </label>
      {{else}}
      <p class="desordem-ficha__dica">{{localize "DESORDEM.Perseguicao.Pre.SemFolego"}}</p>
      {{/if}}
      <label class="desordem-pre__opcao">
        <input type="checkbox" name="avancoEffort">
        <span class="desordem-pre__nome">{{avanco.esforcoTexto}}</span>
      </label>
    </div>
    {{/unless}}
  </fieldset>
  {{/if}}

  <fieldset class="desordem-pre__grupo">
    <legend><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DESORDEM.Ficha.Bonus.Titulo"}}</legend>
    <div class="desordem-bonus__slots" data-slots></div>
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Teste.Pre.DicaEspacos"}}</p>
  </fieldset>

  <fieldset class="desordem-pre__grupo">
    <legend><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "DESORDEM.Teste.Pre.Habilidades"}}</legend>
    {{#each abilities}}
    <label class="desordem-pre__opcao{{#unless available}} is-indisponivel{{/unless}}" data-opcao="{{key}}">
      <input type="checkbox" name="active" value="{{key}}" {{#unless available}}disabled{{/unless}}>
      <span class="desordem-pre__nome">{{label}}</span>
      <span class="desordem-pre__custo">{{costText}}</span>
      {{#if reasonText}}<span class="desordem-pre__motivo">{{reasonText}}</span>{{/if}}
      <span class="desordem-pre__motivo" data-motivo></span>
    </label>
    {{else}}
    <p class="desordem-ficha__dica">{{localize "DESORDEM.Teste.Pre.SemHabilidades"}}</p>
    {{/each}}
  </fieldset>

  {{#if fear}}
  <fieldset class="desordem-pre__grupo" data-pavor-bloco>
    <legend><i class="fa-solid fa-ghost" aria-hidden="true"></i> {{fear.title}}</legend>
    <label class="desordem-pre__opcao{{#unless fear.controlPossible}} is-indisponivel{{/unless}}">
      <input type="checkbox" name="controlFear" {{#unless fear.controlPossible}}disabled{{/unless}}>
      <span class="desordem-pre__nome">{{localize "DESORDEM.Ficha.ControlarPavor"}}</span>
      <span class="desordem-pre__custo">{{fear.controlText}}</span>
    </label>
    <label class="desordem-pre__opcao" data-opcao="embrace">
      <input type="checkbox" name="embraceFear">
      <span class="desordem-pre__nome">{{localize "DESORDEM.Ficha.AbracarPavor"}}</span>
      <span class="desordem-pre__custo">{{fear.embraceText}}</span>
      <span class="desordem-pre__motivo" data-motivo></span>
    </label>
  </fieldset>
  {{/if}}

  <div class="desordem-pre__custos" data-custos></div>
  <p class="desordem-pre__erro" data-erro></p>
</div>

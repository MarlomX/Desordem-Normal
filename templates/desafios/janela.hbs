<section class="desordem-perseguicao desordem-desafio">
  {{#if view}}
  <header class="desordem-perseguicao__topo">
    {{! Chaves montadas: DESORDEM.Desafio.Tipo.estendido, .arrombar, .escalar }}
    <span class="desordem-desafio__tipo"><i class="fa-solid {{icone}}" aria-hidden="true"></i> {{tipoRotulo}}</span>
    <span class="desordem-perseguicao__estado{{#if view.ativo}} is-ativa{{/if}}">{{#if view.ativo}}{{localize "DESORDEM.Desafio.Ativo"}}{{else}}{{localize "DESORDEM.Desafio.Encerrado"}}{{/if}}</span>
    {{#if view.concluido}}<span class="desordem-perseguicao__selo is-chegou">{{localize "DESORDEM.Desafio.Concluido"}}</span>{{/if}}
  </header>

  {{#if view.destrancar}}
  {{! Destrancar: a fechadura (o mestre configura e guarda a senha num sussurro só para os mestres) }}
  <div class="desordem-desafio__grade">
    <label class="desordem-desafio__campo desordem-desafio__campo--largo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Nome"}}</span>
      <input type="text" data-campo="nome" value="{{view.nome}}" maxlength="80" placeholder="{{localize "DESORDEM.Desafio.Estendido.SemNome"}}" autocomplete="off">
    </label>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Fechadura.Complexidade"}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="lock.dados" value="{{view.fechadura.dados}}" min="1" max="10" step="1" inputmode="numeric">
    </label>
    {{! Aplicar a todos: deixa todos os dados iguais de uma vez (a opção vazia não muda nada) }}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Fechadura.Faces"}}</span>
      <select data-campo="lock.faces"><option value="" selected>—</option>{{#each faces}}<option value="{{this}}">d{{this}}</option>{{/each}}</select>
    </label>
    {{! Um dado por posição (ex.: d8 d8 d4 d12) }}
    <div class="desordem-desafio__campo desordem-desafio__campo--largo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Fechadura.DadosPosicao"}}</span>
      <div class="desordem-fechadura__lados">
        {{#each lados}}
        <select data-campo="lock.lado.{{index}}" aria-label="{{label}}" title="{{label}}">{{#each opcoes}}<option value="{{value}}"{{#if selected}} selected{{/if}}>d{{value}}</option>{{/each}}</select>
        {{/each}}
      </div>
    </div>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Fechadura.Maximo"}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="lock.maximo" value="{{view.fechadura.maximo}}" min="0" max="99" step="1" inputmode="numeric" title="{{localize "DESORDEM.Desafio.Fechadura.MaximoDica"}}">
    </label>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Fechadura.Usadas"}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="lock.usadas" value="{{view.fechadura.usadas}}" min="0" max="99" step="1" inputmode="numeric">
    </label>
    <label class="desordem-desafio__marcar desordem-desafio__campo--largo">
      <input type="checkbox" data-campo="lock.mostrarMaximo"{{#if view.fechadura.mostrarMaximo}} checked{{/if}}>
      <span>{{localize "DESORDEM.Desafio.Fechadura.MostrarMaximo"}}</span>
    </label>
    <label class="desordem-desafio__marcar desordem-desafio__campo--largo">
      <input type="checkbox" data-campo="lock.auto"{{#if view.fechadura.auto}} checked{{/if}}>
      <span>{{localize "DESORDEM.Desafio.Fechadura.Auto"}}</span>
    </label>
  </div>
  <div class="desordem-fechadura__senha">
    <span class="desordem-perseguicao__rotulo"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Fechadura.Senha"}}</span>
    {{#if senhaTexto}}
      {{#if mostrarSenha}}<strong class="desordem-desafios__numero">{{senhaTexto}}</strong>{{else}}<span>{{localize "DESORDEM.Desafio.Fechadura.Guardada"}}</span>{{/if}}
      <button type="button" data-action="toggleSecret" title="{{localize "DESORDEM.Desafio.Fechadura.MostrarDica"}}"><i class="fa-solid {{#if mostrarSenha}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button>
    {{else}}
      <span>{{#if view.fechadura.temSenha}}{{localize "DESORDEM.Desafio.Fechadura.Perdida"}}{{else}}{{localize "DESORDEM.Desafio.Fechadura.SemSenhaCurto"}}{{/if}}</span>
    {{/if}}
  </div>
  <div class="desordem-perseguicao__acoes">
    <button type="button" data-action="generateSecret"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Fechadura.Gerar"}}</button>
    <button type="button" data-action="defineSecret"><i class="fa-solid fa-keyboard" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Fechadura.Definir"}}</button>
    <button type="button" data-action="resetLock" title="{{localize "DESORDEM.Desafio.Fechadura.NovaDica"}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Fechadura.Nova"}}</button>
  </div>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Desafio.Fechadura.Dica"}}</p>
  {{#if fechaduraEstragada}}
  <div class="desordem-fechadura__estragou">
    <span>{{localize "DESORDEM.Desafio.Fechadura.Estragou"}}</span>
    <button type="button" data-action="createForce"><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Fechadura.CriarArrombar"}}</button>
  </div>
  {{/if}}
  {{else}}
  <div class="desordem-desafio__grade">
    <label class="desordem-desafio__campo desordem-desafio__campo--largo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Nome"}}</span>
      <input type="text" data-campo="nome" value="{{view.nome}}" maxlength="80" placeholder="{{localize "DESORDEM.Desafio.Estendido.SemNome"}}" autocomplete="off">
    </label>
    {{#if view.temPa}}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{#if view.equilibrio}}{{localize "DESORDEM.Desafio.Equilibrio.Rodadas"}}{{else}}{{localize "DESORDEM.Desafio.PAAlvo"}}{{/if}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="pa" value="{{view.pa}}" min="1" max="999" step="1" inputmode="numeric">
    </label>
    {{/if}}
    {{#if view.escalar}}
    {{! Escalada: sempre individual; rápida soma a RA, cautelosa soma a RB, falhar é queda }}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.DtRapida"}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="dtRapida" value="{{view.dtRapida}}" min="1" max="40" step="1" inputmode="numeric">
    </label>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.DtCautelosa"}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="dtCautelosa" value="{{view.dtCautelosa}}" min="1" max="40" step="1" inputmode="numeric">
    </label>
    {{else}}
    {{! Alcançar: a DT do ambiente é a da forma segura; a arriscada é ela +3 }}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{#if view.alcancar}}{{localize "DESORDEM.Desafio.DtSegura"}}{{else}}{{localize "DESORDEM.Perseguicao.DT"}}{{/if}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="dt" value="{{view.dt}}" min="1" max="40" step="1" inputmode="numeric">
    </label>
    {{#if view.alcancar}}
    <div class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.DtArriscada"}}</span>
      <strong class="desordem-desafios__numero">{{view.dtArriscada}}</strong>
    </div>
    {{/if}}
    {{/if}}
    {{#if view.livre}}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.ModoRotulo"}}</span>
      <select data-campo="modo">{{#each modos}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.PassarRotulo"}}</span>
      <select data-campo="somaPassar">{{#each passar}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.FalharRotulo"}}</span>
      <select data-campo="somaFalhar">{{#each falhar}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    {{/if}}
    <label class="desordem-desafio__campo">
      <span class="desordem-perseguicao__rotulo">{{#if view.sustentar}}{{localize "DESORDEM.Desafio.CustoInicio"}}{{else}}{{localize "DESORDEM.Desafio.Custo"}}{{/if}}</span>
      <input type="number" class="desordem-perseguicao__campo" data-campo="custoPv" value="{{view.custoPv}}" min="0" max="20" step="1" inputmode="numeric">
    </label>
    {{#unless view.sustentar}}
    <label class="desordem-desafio__marcar desordem-desafio__campo--largo">
      <input type="checkbox" data-campo="revelarPa"{{#if view.revelarPa}} checked{{/if}}>
      <span>{{localize "DESORDEM.Desafio.RevelarPa"}}</span>
    </label>
    {{/unless}}
  </div>
  {{! Dica do tipo (chaves: Estendido.Dica, Escalar.Dica, Alcancar.Dica, Sustentar.Dica) }}
  <p class="desordem-ficha__dica">{{dica}}</p>
  {{#unless view.sustentar}}<p class="desordem-ficha__dica">{{localize "DESORDEM.Desafio.CustoDica"}}</p>{{/unless}}
  {{/if}}

  {{#if view.grupo}}
  <div class="desordem-desafios__total">
    <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Total"}}</span>
    <span class="desordem-perseguicao__valor">
      <button type="button" class="desordem-perseguicao__passo" data-action="adjustPoints" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>
      <input type="number" class="desordem-perseguicao__campo" data-campo="total" value="{{view.total}}" min="0" max="9999" step="1" inputmode="numeric" aria-label="{{localize "DESORDEM.Desafio.Total"}}">
      <button type="button" class="desordem-perseguicao__passo" data-action="adjustPoints" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>
    </span>
    <strong class="desordem-desafios__numero">/ {{view.pa}}</strong>
  </div>
  {{/if}}

  <h3 class="desordem-perseguicao__titulo"><i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Participantes"}} ({{view.participantes.length}})</h3>
  {{#if view.participantes.length}}
  <ul class="desordem-perseguicao__lista">
    {{#each view.participantes}}
    <li class="desordem-perseguicao__item{{#if chegou}} is-chegou{{/if}}">
      <div class="desordem-perseguicao__linha">
        {{#if img}}<img class="desordem-perseguicao__retrato" src="{{img}}" alt="">{{/if}}
        <span class="desordem-perseguicao__nome">{{#if missing}}{{localize "DESORDEM.Desafio.AtorSumiu"}}{{else}}{{name}}{{/if}}</span>
        {{#if chegou}}<span class="desordem-perseguicao__selo is-chegou">{{localize "DESORDEM.Desafio.Concluido"}}</span>{{/if}}
        {{#unless ../view.semPontos}}{{#unless ../view.grupo}}
        <span class="desordem-perseguicao__valor">
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustPoints" data-actor-id="{{actorId}}" data-delta="-1" title="{{localize "DESORDEM.Ficha.Cab.Diminuir"}}">−</button>
          <input type="number" class="desordem-perseguicao__campo" data-campo="pontos" data-actor-id="{{actorId}}" value="{{pontos}}" min="0" max="9999" step="1" inputmode="numeric" aria-label="{{localize "DESORDEM.Desafio.Pontos"}}">
          <button type="button" class="desordem-perseguicao__passo" data-action="adjustPoints" data-actor-id="{{actorId}}" data-delta="1" title="{{localize "DESORDEM.Ficha.Cab.Aumentar"}}">+</button>
        </span>
        <span class="desordem-perseguicao__rotulo">{{@root.pontosRotulo}}</span>
        {{/unless}}{{/unless}}
        {{#if ../view.equilibrio}}
        {{! Equilíbrio: d4 que restam (vazio = reserva cheia, metade da Acrobacia) }}
        <label class="desordem-desafio__reserva" title="{{localize "DESORDEM.Desafio.Equilibrio.ReservaDica"}}">
          <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Equilibrio.Reserva"}}</span>
          <input type="number" class="desordem-perseguicao__campo" data-campo="reserva" data-actor-id="{{actorId}}" value="{{#unless reservaCheia}}{{reserva}}{{/unless}}" min="0" max="20" step="1" inputmode="numeric" placeholder="{{localize "DESORDEM.Desafio.Equilibrio.Cheia"}}">
        </label>
        {{/if}}
        <button type="button" class="desordem-perseguicao__remover" data-action="removeParticipant" data-actor-id="{{actorId}}" title="{{localize "DESORDEM.Desafio.Remover"}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      </div>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="desordem-perseguicao__vazio">{{localize "DESORDEM.Desafio.SemParticipantes"}}</p>
  {{/if}}

  <div class="desordem-perseguicao__acoes">
    {{#unless view.lotado}}
    <button type="button" data-action="addParticipants"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> {{localize "DESORDEM.Perseguicao.Adicionar"}}</button>
    <button type="button" data-action="addSelected" title="{{localize "DESORDEM.Desafio.AdicionarSelecionadosDica"}}"><i class="fa-solid fa-object-group" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.AdicionarSelecionados"}}</button>
    {{/unless}}
    <button type="button" data-action="openPenalty"><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Penalidade.Abrir"}}</button>
    <button type="button" data-action="toggleActive">{{#if view.ativo}}<i class="fa-solid fa-stop" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Encerrar"}}{{else}}<i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Reabrir"}}{{/if}}</button>
    <button type="button" class="desordem-perseguicao__perigo" data-action="deleteChallenge"><i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Excluir"}}</button>
  </div>
  {{else}}
  <p class="desordem-perseguicao__vazio">{{localize "DESORDEM.Desafio.NaoExiste"}}</p>
  {{/if}}
</section>

<section class="desordem-desafios">
  <header class="desordem-desafios__topo">
    <h3 class="desordem-perseguicao__titulo"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Guia"}}</h3>
  </header>
  {{#if isGM}}
  {{! Um botão por tipo: teste estendido, arrombar e escalar (cada um com os seus padrões) }}
  <div class="desordem-desafios__novos">
    <span class="desordem-perseguicao__rotulo"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "DESORDEM.Desafio.Novo"}}</span>
    {{#each tipos}}
    <button type="button" data-action="newChallenge" data-tipo="{{tipo}}"{{#unless @root.podeCriar}} disabled title="{{localize "DESORDEM.Desafio.Limite"}}"{{/unless}}><i class="fa-solid {{icone}}" aria-hidden="true"></i> {{rotulo}}</button>
    {{/each}}
  </div>
  {{/if}}

  {{#if desafios.length}}
  <ul class="desordem-desafios__lista">
    {{#each desafios}}
    <li class="desordem-desafios__item{{#unless ativo}} is-encerrado{{/unless}}{{#if concluido}} is-concluido{{/if}}">
      <div class="desordem-desafios__cabeca">
        <i class="fa-solid {{icone}}" aria-hidden="true" title="{{tipoRotulo}}"></i>
        {{#if @root.isGM}}
        <button type="button" class="desordem-desafios__nome" data-action="openChallenge" data-challenge-id="{{id}}" title="{{localize "DESORDEM.Desafio.Editar"}}">{{#if semNome}}{{localize "DESORDEM.Desafio.Estendido.SemNome"}}{{else}}{{nome}}{{/if}}</button>
        {{else}}
        <span class="desordem-desafios__nome">{{#if semNome}}{{localize "DESORDEM.Desafio.Estendido.SemNome"}}{{else}}{{nome}}{{/if}}</span>
        {{/if}}
        {{#if concluido}}<span class="desordem-perseguicao__selo is-chegou">{{localize "DESORDEM.Desafio.Concluido"}}</span>{{/if}}
        {{#unless ativo}}<span class="desordem-perseguicao__selo">{{localize "DESORDEM.Desafio.Encerrado"}}</span>{{/unless}}
        {{#if estragada}}<span class="desordem-perseguicao__selo">{{localize "DESORDEM.Desafio.Fechadura.Estragada"}}</span>{{/if}}
      </div>
      <div class="desordem-desafios__info">
        {{#if destrancar}}
        {{! Destrancar: dados da fechadura e tentativas do grupo }}
        <span>{{fechadura.composicao}}</span>
        <span>{{localize "DESORDEM.Desafio.Fechadura.TentativasCurto"}} <strong>{{fechadura.usadas}}{{#if fechadura.maximoVisivel}}/{{fechadura.maximo}}{{/if}}{{#if fechadura.infinito}}/∞{{/if}}</strong></span>
        {{else}}
        <span>{{#if grupo}}{{localize "DESORDEM.Desafio.Modo.grupo"}}{{else}}{{localize "DESORDEM.Desafio.Modo.individual"}}{{/if}}</span>
        {{#if escalar}}
        <span>{{localize "DESORDEM.Perseguicao.DT"}} <strong>{{dtRapida}}/{{dtCautelosa}}</strong></span>
        {{else}}
        <span>{{localize "DESORDEM.Perseguicao.DT"}} <strong>{{dt}}</strong></span>
        {{/if}}
        {{#if custoPv}}<span>{{localize "DESORDEM.Desafio.CustoCurto"}} <strong>{{localize "DESORDEM.Desafio.CustoValor" pv=custoPv}}</strong></span>{{/if}}
        {{#if mostrarPa}}<span>{{localize "DESORDEM.Desafio.PA"}} <strong>{{pa}}</strong></span>{{/if}}
        {{/if}}
      </div>
      {{#if grupo}}
      <div class="desordem-desafios__total">
        <span class="desordem-perseguicao__rotulo">{{localize "DESORDEM.Desafio.Total"}}</span>
        <strong class="desordem-desafios__numero">{{total}}{{#if mostrarPa}} / {{pa}}{{/if}}</strong>
      </div>
      {{/if}}
      {{#if participantes.length}}
      <ul class="desordem-desafios__pessoas">
        {{#each participantes}}
        <li class="desordem-desafios__pessoa{{#if chegou}} is-chegou{{/if}}">
          <span class="desordem-perseguicao__nome">{{#if missing}}{{localize "DESORDEM.Desafio.AtorSumiu"}}{{else}}{{name}}{{/if}}</span>
          {{#unless ../semPontos}}{{#unless ../grupo}}<span class="desordem-desafios__numero">{{pontos}}{{#if ../mostrarPa}} / {{../pa}}{{/if}} {{../unidade}}</span>{{/unless}}{{/unless}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="desordem-perseguicao__vazio">{{localize "DESORDEM.Desafio.SemParticipantes"}}</p>
      {{/if}}
      {{#if @root.isGM}}
      <div class="desordem-desafios__acoes">
        <button type="button" data-action="openChallenge" data-challenge-id="{{id}}" title="{{localize "DESORDEM.Desafio.Editar"}}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>
        <button type="button" data-action="toggleActive" data-challenge-id="{{id}}" title="{{#if ativo}}{{localize "DESORDEM.Desafio.Encerrar"}}{{else}}{{localize "DESORDEM.Desafio.Reabrir"}}{{/if}}"><i class="fa-solid {{#if ativo}}fa-stop{{else}}fa-rotate-left{{/if}}" aria-hidden="true"></i></button>
        <button type="button" class="desordem-perseguicao__perigo" data-action="deleteChallenge" data-challenge-id="{{id}}" title="{{localize "DESORDEM.Desafio.Excluir"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="desordem-perseguicao__vazio">{{#if isGM}}{{localize "DESORDEM.Desafio.VazioMestre"}}{{else}}{{localize "DESORDEM.Desafio.VazioJogador"}}{{/if}}</p>
  {{/if}}
</section>

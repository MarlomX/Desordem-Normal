<section class="desordem-aba{{#if tabState.acoes}} is-active{{/if}}" data-tab-panel="acoes">
<section class="desordem-ficha__secao desordem-criatura__ataques">
  <h3><i class="fa-solid fa-hand-fist" aria-hidden="true"></i> {{localize "DESORDEM.Criatura.Ataques"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Criatura.DicaAtaques"}}</p>
  {{#each attacks}}
  <div class="desordem-item-linha" data-item-id="{{id}}" draggable="true">
    <span class="desordem-item-linha__nome" title="{{descricao}}"><strong>{{name}}</strong> — {{kindLabel}} · {{skillLabel}} ({{localize "DESORDEM.Criatura.Teste"}} {{testLabel}}, {{localize "DESORDEM.Ficha.Dano"}} {{damageLabel}}){{#if naoLetal}} ({{localize "DESORDEM.Dano.NaoLetal"}}){{/if}}</span>
    <button type="button" data-action="attackWeapon" data-item-id="{{id}}" {{#if locked}}disabled{{/if}}>{{localize "DESORDEM.Ficha.Atacar"}}</button>
    <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
    {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
  </div>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Criatura.SemAtaques"}}</p>
  {{/each}}
  {{#if editable}}<button type="button" data-action="createItem" data-type="arma">{{localize "DESORDEM.Criatura.NovoAtaque"}}</button>{{/if}}
</section>
<section class="desordem-ficha__secao desordem-ficha__habilidades">
  <h3><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "DESORDEM.Criatura.Habilidades"}}</h3>
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Criatura.DicaHabilidades"}}</p>
  {{#if abilities.length}}<button type="button" class="desordem-habilidade__todas" data-action="toggleAbilities">{{localize "DESORDEM.Ficha.Hab.AlternarTodas"}}</button>{{/if}}
  {{#each abilities}}
  <div class="desordem-habilidade" data-item-id="{{id}}" draggable="true">
    <details class="desordem-habilidade__detalhes" data-habilidade="{{id}}" {{#if open}}open{{/if}}>
      <summary class="desordem-habilidade__titulo">
        <strong>{{name}}</strong>
        <span class="desordem-habilidade__acoes">
          <button type="button" data-action="editItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Editar"}}">✎</button>
          {{#unless locked}}<button type="button" class="desordem-ficha__remover" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "DESORDEM.Item.Remover"}}">×</button>{{/unless}}
        </span>
      </summary>
      <p class="desordem-ficha__dica desordem-criatura__texto">{{#if descricao}}{{descricao}}{{else}}{{localize "DESORDEM.Ficha.Hab.SemDescricao"}}{{/if}}</p>
    </details>
  </div>
  {{else}}
  <p class="desordem-ficha__dica">{{localize "DESORDEM.Criatura.SemHabilidades"}}</p>
  {{/each}}
  {{#if editable}}<button type="button" data-action="createItem" data-type="habilidade">{{localize "DESORDEM.Item.Novo.habilidade"}}</button>{{/if}}
</section>
</section>
